---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'

const faqs = [
  {
    question: "My child hasn't chosen between piano and violin yet — can Patricia help?",
    answer: "Absolutely. This is one of the most common reasons families book an initial consultation. Patricia will spend time with your child, letting them explore both instruments in a relaxed setting. She observes their natural responses — hand size, physical coordination, what catches their interest — and gives you an honest recommendation. There's no pressure to decide on the spot."
  },
  {
    question: "Do we need to own an instrument before starting?",
    answer: "No. For piano, Patricia's studio has a quality instrument ready for lessons. For violin, she'll assess your child's measurements during the first consultation and recommend the correct fractional size — typically 1/4 or 1/2 for younger beginners. She can advise on renting or purchasing options in Singapore so you don't buy the wrong size."
  },
  {
    question: "How does being in Tengah benefit my child's music education?",
    answer: "The biggest advantage is convenience. With Patricia's studio right here in Tengah, your child arrives fresh and focused rather than tired from a long commute. Weekly lessons are easier to maintain when there's no travel friction, and that consistency is what drives real progress. You also get a teacher who understands the Tengah community — the young families, the growing neighbourhood, the need for quality local services."
  },
  {
    question: "Can my child learn both piano and violin?",
    answer: "Yes, some students do study both instruments. Patricia typically recommends establishing a solid foundation on one instrument first — usually over six to twelve months — before adding a second. This prevents early confusion between the very different physical techniques each instrument requires. Once the first instrument feels natural, adding a second becomes a genuine enrichment rather than a source of frustration."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}
---

<BaseLayout
  title="Music Lessons for Children in Tengah | Music with Pat"
  description="Music lessons for children in Tengah, Singapore. Piano, violin, and musicianship from Patricia's home studio right here in Tengah — no travel needed."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Music Lessons",
      "name": "Music Lessons for Children in Tengah",
      "provider": {
        "@type": "LocalBusiness",
        "@id": "https://www.musicwithpat.com/#business",
        "name": "Music with Pat"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Tengah, Singapore"
      },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedMinAge": 4
      },
      "description": "Piano, violin, and musicianship lessons for children in Tengah, Singapore. Patricia's home studio is located right in Tengah — your local music teacher with ABRSM preparation."
    }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  </Fragment>

  <Header />
  <Breadcrumbs items={[{ label: 'Music Lessons Tengah' }]} />

  <main>
    <!-- Hero -->
    <section class="py-10 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">Right Here in Tengah</p>
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-serif font-semibold text-base-900 mb-4">
          Music Lessons for Children in Tengah
        </h1>
        <p class="text-base-600 text-lg md:text-xl max-w-2xl mx-auto mb-6">
          Tengah is filling up with young families — and now it has a dedicated music teacher to match. Patricia's home studio is right here in the neighbourhood, offering piano, violin, and musicianship lessons without the commute. Whether your child is drawn to the piano keys, curious about the violin, or still deciding, Patricia provides patient, structured teaching that meets them where they are. Singapore's newest town deserves quality music education on its doorstep.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact/" class="px-6 py-3 bg-primary-600 text-white font-medium rounded-xl hover:bg-primary-700 transition-colors">Book a Trial</a>
          <a href="https://wa.me/6583898853?text=Hi%20Pat!%20I'm%20interested%20in%20music%20lessons%20for%20my%20child%20in%20Tengah." target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-green-500 text-white font-medium rounded-xl hover:bg-green-600 transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </section>

    <!-- About Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2">
            <img
              src="/patricia-piano-lessons.webp"
                width="1024"
                height="1280"
              alt="Patricia - Music Teacher for Children in Tengah"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full"
              loading="lazy"
            />
          </div>
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2">Meet the Teacher</p>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">
              About Patricia
            </h2>
            <p class="text-base-600 mb-4">
              Patricia is a Tengah resident with over a decade of experience teaching music to children. She teaches both piano and violin from her home studio right here in the neighbourhood, making her one of the few dedicated children's music teachers based in Tengah itself.
            </p>
            <p class="text-base-600 mb-4">
              Her Bachelor's degree in Early Childhood Education with Music Education gives her a distinctive combination of skills. She understands the technical demands of both instruments and how young children learn — which means she builds lessons that are developmentally appropriate, musically sound, and genuinely engaging for each student.
            </p>
            <p class="text-base-600 mb-6">
              Patricia is warm and attentive, but she holds her students to a standard. She builds strong foundations from the start and communicates openly with parents about progress, expectations, and what's working. Whether your child is exploring music for the first time or preparing for ABRSM examinations, she provides the same dedicated, personalised guidance.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">B.Ed Early Childhood & Music</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">10+ Years Experience</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">ABRSM Preparation</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Ages 4+</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Why Tengah Families Choose Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Why Families Trust Patricia</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Why Tengah Families Choose Patricia
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Tengah's Own Music Teacher</h3>
                <p class="text-base-600 text-sm">Patricia lives and teaches in Tengah. No other music school or commercial centre needed — her studio is within walking or cycling distance for most residents. Weekly lessons slot naturally into your family's routine without the friction of cross-town travel.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 11-.99-3.467l2.31-.66a2.25 2.25 0 001.632-2.163zm0 0V4.228a2.25 2.25 0 00-.798-1.716l-1.287-1.093a.75.75 0 00-1.165.26L3.25 11.197a2.25 2.25 0 001.398 2.92l8.03 2.636a2.25 2.25 0 002.822-1.47V9z" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Piano and Violin Under One Roof</h3>
                <p class="text-base-600 text-sm">Patricia teaches both piano and violin, which means families with multiple children or a child still exploring can access both instruments from the same trusted teacher. There's no need to coordinate with different schools or tutors — everything happens in one place, with one person who knows your family.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Built for Young Learners</h3>
                <p class="text-base-600 text-sm">Patricia's formal training in Early Childhood Education means she understands how children at different ages absorb new skills. She adapts every lesson to the child in front of her — adjusting pace, activity type, and complexity to match their developmental stage. This is especially valuable for four- and five-year-olds just beginning their musical journey.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Flexible Pathways</h3>
                <p class="text-base-600 text-sm">Whether your child thrives with the structure of ABRSM exams or prefers building repertoire and confidence at their own pace, Patricia supports both approaches. She'll recommend what she genuinely believes works best and adjust as your child grows. There's no one-size-fits-all programme here.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Your Local Studio -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">No Commute Needed</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Your Local Studio
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <p class="text-base-600 mb-4">
              Most Tengah families currently have to travel to Jurong East, Bukit Batok, or further afield for music lessons. Patricia's studio changes that. Located right within Tengah's residential area, it's reachable on foot or by bicycle for families in the Plantation District, Garden District, and Park District.
            </p>
            <p class="text-base-600 mb-4">
              The convenience goes beyond saving time. Children who arrive at lessons relaxed and unhurried learn better — they're more focused, more receptive, and more likely to enjoy the session. That positive experience compounds over months and years of lessons.
            </p>
            <p class="text-base-600">
              As the Jurong Region Line develops and Tengah's town centre takes shape, the neighbourhood will gain more amenities. But quality music teaching is available right now, right here — and that's an advantage worth acting on while Patricia's schedule still has availability.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-4">The Local Advantage</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">On foot:</strong> Walking distance for most Tengah residents — truly local lessons</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By bicycle:</strong> Tengah's cycling paths make reaching the studio quick and enjoyable</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">Zero commute:</strong> No driving, no MRT transfers, no parking hassles</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">House visits:</strong> Also available throughout Tengah if you prefer lessons at home</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- What Lessons Look Like -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Lesson Structure</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            What Lessons Look Like
          </h2>
        </div>

        <div class="space-y-4 text-base-600">
          <p>
            Every lesson is a private, one-to-one session lasting 45 to 60 minutes. Younger beginners start with shorter sessions that extend gradually as their concentration develops. Whether your child is learning piano, violin, or still exploring, each session is shaped around their current level and learning style.
          </p>
          <p>
            Piano students work on technique, repertoire, sight-reading, aural skills, and theory in each session. Violin students build posture, bow control, tone production, and scales alongside their pieces. Patricia keeps lessons varied and engaging, weaving different elements together so children develop well-rounded musicianship rather than just technical ability.
          </p>
          <p>
            For families still deciding between instruments, Patricia offers introductory sessions where your child can try both piano and violin. She observes their natural aptitude and interest before recommending the best path forward — always with your child's enjoyment and long-term development in mind.
          </p>
        </div>

        <div class="text-center mt-8">
          <a href="/lessons/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            View Full Lesson Details
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Common Questions</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="group bg-primary-50 rounded-xl">
              <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
                <span class="font-medium text-base-900 text-sm md:text-base pr-4">{faq.question}</span>
                <span class="text-primary-600 group-open:rotate-45 transition-transform text-xl flex-shrink-0">+</span>
              </summary>
              <div class="px-4 pb-4 text-base-600 text-sm">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Also Available -->
    <section class="py-6 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also available in Tengah:
          <a href="/piano-lessons-tengah/" class="text-primary-600 hover:underline">Piano Lessons</a> ·
          <a href="/violin-lessons-tengah/" class="text-primary-600 hover:underline">Violin Lessons</a> ·
          <a href="/abrsm-piano-lessons-tengah/" class="text-primary-600 hover:underline">ABRSM Piano</a> ·
          <a href="/abrsm-violin-lessons-tengah/" class="text-primary-600 hover:underline">ABRSM Violin</a> ·
          <a href="/music-theory-lessons-tengah/" class="text-primary-600 hover:underline">Music Theory</a>
        </p>
      </div>
    </section>

    <!-- Also Serving Nearby -->
    <section class="py-8 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also serving families in
          <a href="/music-lessons-jurong-west/" class="text-primary-600 hover:underline">Jurong West</a>,
          <a href="/music-lessons-bukit-batok/" class="text-primary-600 hover:underline">Bukit Batok</a>,
          <a href="/music-lessons-bukit-panjang/" class="text-primary-600 hover:underline">Bukit Panjang</a>, and
          <a href="/music-lessons-choa-chu-kang/" class="text-primary-600 hover:underline">Choa Chu Kang</a>.
          <a href="/lessons/" class="text-primary-600 hover:underline">View all lesson details</a>.
        </p>
      </div>
    </section>

    <!-- Parent Testimonial -->
    <section class="py-12 md:py-20 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">From Parents</p>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-6">
          What Parents Say
        </h2>
        <div class="space-y-4">
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary-100">
            <p class="text-base-700 italic mb-3">"We tried other teachers before, but Pat's nurturing approach finally got my son excited about music. He now practices without being asked!"</p>
            <p class="text-base-500 text-sm">— Michelle T., Mother of Ryan, Age 9</p>
          </div>
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary-100">
            <p class="text-base-700 italic mb-3">"Pat prepared my daughter for her ABRSM Grade 3 exam and she passed with distinction! Highly recommend for anyone looking for quality music lessons."</p>
            <p class="text-base-500 text-sm">— Jennifer C., Mother of Sophie, Age 11</p>
          </div>
        </div>
        <a href="/testimonials/" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1 mt-4">
          Read all testimonials
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-white border-t border-primary-100">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-3">
          Start Your Child's Musical Journey
        </h2>
        <p class="text-base-600 mb-6">Get in touch with Patricia for a free consultation to discuss your child's interests and what lessons could look like. No commitment needed.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/contact/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            Book a Trial
          </a>
          <a
            href="https://wa.me/6583898853?text=Hi%20Pat!%20I'm%20interested%20in%20music%20lessons%20for%20my%20child%20in%20Tengah."
