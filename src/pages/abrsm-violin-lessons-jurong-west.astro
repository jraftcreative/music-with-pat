---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'

const faqs = [
  {
    question: "Can my child switch from another violin teacher to Patricia mid-grade?",
    answer: "Yes, and Patricia handles transitions carefully. She will assess your child's current technical foundation, identify any gaps in their ABRSM preparation, and create a plan to address them without losing momentum. Switching teachers mid-grade is common and can actually be beneficial if the previous approach was not working. Patricia focuses on getting the student back on a solid track as efficiently as possible."
  },
  {
    question: "How much daily practice does my child need for ABRSM violin exams?",
    answer: "For younger students in Grades 1 to 3, Patricia recommends 20 to 30 minutes of focused daily practice. From Grade 4 onwards, 30 to 45 minutes becomes necessary, increasing further for Grades 6 to 8. Quality matters more than quantity — Patricia teaches students how to practise effectively, breaking material into sections and working on specific skills rather than simply playing pieces through from start to finish."
  },
  {
    question: "What happens if my child's intonation is not accurate enough for their target grade?",
    answer: "Patricia will address this directly and honestly. She may recommend spending additional time on foundational exercises before entering the exam, or she may suggest targeting an earlier exam session to allow more preparation time. Intonation improves with consistent, targeted work — scales, slow practice, drone exercises, and careful listening — and Patricia will create a specific plan to bring your child's pitch accuracy up to the required standard."
  },
  {
    question: "Are there different ABRSM exam options for violin besides the traditional graded exams?",
    answer: "Yes. ABRSM offers Performance Grades (which focus entirely on performing a programme of pieces without scales or sight-reading) and the Prep Test (a non-assessed introductory experience for younger beginners). Patricia can guide you on which pathway suits your child best. Many students benefit from starting with the Prep Test to build exam familiarity, while Performance Grades can suit students who excel at repertoire but find the traditional exam format stressful."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}
---

<BaseLayout
  title="ABRSM Violin Lessons in Jurong West | Music with Pat"
  description="ABRSM violin exam preparation for children in Jurong West, Singapore. Comprehensive grade-by-grade preparation from Prep Test to Grade 8 at Patricia's Tengah studio, around 10 minutes from Jurong West via Jurong West Ave 1."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "ABRSM Violin Lessons",
      "name": "ABRSM Violin Lessons for Children in Jurong West",
      "provider": {
        "@type": "LocalBusiness",
        "@id": "https://www.musicwithpat.com/#business",
        "name": "Music with Pat"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Jurong West, Singapore"
      },
