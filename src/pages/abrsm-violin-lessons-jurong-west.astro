      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also serving families in
          <a href="/abrsm-violin-lessons-jurong-east/" class="text-primary-600 hover:underline">Jurong East</a>,
          <a href="/abrsm-violin-lessons-choa-chu-kang/" class="text-primary-600 hover:underline">Choa Chu Kang</a>.
          <a href="/abrsm-violin-lessons-singapore/" class="text-primary-600 hover:underline">View all ABRSM violin lessons</a>.
        </p>
      </div>
