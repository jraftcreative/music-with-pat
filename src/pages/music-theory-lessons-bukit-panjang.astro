---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'

const faqs = [
  {
    question: "Is music theory boring for children?",
    answer: "Many Bukit Panjang parents worry about this, but Patricia's lessons are designed to keep children actively engaged. Rather than working through worksheets in silence, students clap rhythms, identify chords by ear at the keyboard, analyse short passages from pieces they are learning, and complete creative tasks like writing a four-bar melody. The result is a lesson that feels like a natural part of making music rather than a chore separate from it."
  },
  {
    question: "When should my child start dedicated theory lessons?",
    answer: "Patricia introduces foundational theory from the very first practical lesson — note reading, rhythm counting, and dynamic awareness are all theory in action. Formal ABRSM theory exam preparation typically begins when a child is around Grade 3 or 4 on their instrument, which leaves a comfortable runway to complete Grade 5 Theory before it becomes a prerequisite for higher practical exams."
  },
  {
    question: "Can theory be integrated with my child's piano or violin lessons?",
    answer: "Absolutely. Patricia offers two approaches: integrated lessons where theory concepts are woven into each practical session, and standalone theory lessons dedicated entirely to ABRSM exam preparation. Many Bukit Panjang families start with the integrated approach and transition to standalone sessions when focused exam preparation becomes necessary."
  },
  {
    question: "How long does it take to prepare for ABRSM Grade 5 Theory?",
    answer: "Most students require between 6 and 12 months of consistent weekly study. The timeline depends on how much theory the child has absorbed through practical lessons, their confidence with written and analytical work, and how regularly they revise at home. Patricia creates a personalised preparation plan and monitors progress closely throughout."
  },
  {
    question: "Why is Grade 5 Theory required?",
    answer: "ABRSM mandates a pass in Grade 5 Theory (or Grade 5 Practical Musicianship, or Grade 5 in a second instrument) before a student can enter Grades 6, 7, or 8 practical exams. It is a gatekeeper qualification, and Patricia encourages Bukit Panjang families to plan ahead so that theory never becomes a bottleneck that delays practical progress."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}
---

<BaseLayout
  title="Music Theory Lessons in Bukit Panjang | Music with Pat"
  description="ABRSM music theory lessons for children in Bukit Panjang, Singapore. Grades 1–5 theory preparation integrated with piano and violin instruction."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Music Theory Lessons",
      "name": "Music Theory Lessons in Bukit Panjang",
      "provider": {
        "@type": "LocalBusiness",
        "@id": "https://www.musicwithpat.com/#business",
        "name": "Music with Pat"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Bukit Panjang, Singapore"
      },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedMinAge": 4
      },
      "description": "ABRSM music theory preparation for children in Bukit Panjang, Singapore. Covering Grades 1 through 5 with engaging, interactive teaching methods at a dedicated studio in Tengah."
    }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  </Fragment>

  <Header />
  <Breadcrumbs items={[{ label: 'Music Theory Lessons Bukit Panjang' }]} />

  <main>
    <!-- Hero -->
    <section class="py-10 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">Bukit Panjang & Tengah</p>
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-serif font-semibold text-base-900 mb-4">
          Music Theory Lessons in Bukit Panjang
        </h1>
        <p class="text-base-600 text-lg md:text-xl max-w-2xl mx-auto mb-6">
          Bukit Panjang is a well-established residential town where families from Greenridge Primary, West View Primary, and Zhenghua Primary take their children's education seriously. Music theory is the part of a child's musical journey that transforms note-reading into genuine understanding. Patricia teaches ABRSM theory Grades 1 through 5 with practical, hands-on methods that connect every written concept to real music — giving your child the tools to not just play their instrument, but to truly comprehend the music on the page.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact/" class="px-6 py-3 bg-primary-600 text-white font-medium rounded-xl hover:bg-primary-700 transition-colors">Book a Trial</a>
          <a href="https://wa.me/6583898853?text=Hi%20Pat!%20I'm%20interested%20in%20music%20theory%20lessons%20for%20my%20child%20in%20Bukit%20Panjang." target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-whatsapp text-white font-medium rounded-xl hover:bg-whatsapp-dark transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </section>

    <!-- About Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2">
            <img
              src="/patricia-piano-lessons.webp"
                width="1024"
                height="1280"
              alt="Patricia - Music Theory Teacher for Children near Bukit Panjang"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full"
              loading="lazy"
            />
          </div>
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2">Meet the Teacher</p>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">
              About Patricia
            </h2>
            <p class="text-base-600 mb-4">
              Patricia has spent over a decade teaching music to children, and her philosophy on theory is refreshingly practical: every concept should make the student a better musician at their instrument. When she teaches intervals, she plays them at the piano so the student hears the difference. When she explains key signatures, she links them to pieces the child is already learning. Theory never exists in isolation.
            </p>
            <p class="text-base-600 mb-4">
              With a Bachelor's degree in Early Childhood Education with Music Education, Patricia knows how to adapt abstract musical concepts for young learners. She recognises that a six-year-old absorbs information differently from a ten-year-old, and she adjusts her explanations, exercises, and pacing accordingly — keeping every student challenged without feeling overwhelmed.
            </p>
            <p class="text-base-600 mb-6">
              Bukit Panjang parents appreciate her structured yet flexible approach. She sets a clear syllabus timeline, provides regular progress updates, and is always transparent about where a child stands in relation to their exam goals.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">B.Ed Early Childhood & Music</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">10+ Years Experience</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">ABRSM Preparation</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Ages 4+</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Learn Music Theory -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Why Theory Matters</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Why Families in Bukit Panjang Invest in Music Theory
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">ABRSM Requirement</h3>
                <p class="text-base-600 text-sm">A pass in Grade 5 Theory is mandatory before any student can sit for ABRSM Grades 6, 7, or 8 practical exams. Patricia helps Bukit Panjang families plan ahead, starting theory preparation early enough that the requirement is met smoothly — without last-minute pressure or delays to practical exam schedules.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Faster Piece Learning</h3>
                <p class="text-base-600 text-sm">A child who understands key signatures, scale patterns, and chord structures can learn new pieces significantly faster. Instead of decoding each note individually, they recognise musical patterns and groupings — cutting down the time it takes to move from first read-through to polished performance.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Stronger Sight-Reading</h3>
                <p class="text-base-600 text-sm">Sight-reading is one of the areas where theory knowledge pays immediate dividends. When a student can instantly identify a key signature, anticipate interval leaps, and feel the pulse of a time signature, they navigate unfamiliar scores with far greater fluency and confidence.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Deeper Musical Expression</h3>
                <p class="text-base-600 text-sm">Understanding why a composer chose a particular key, how a harmonic progression creates tension and resolution, or what makes a rhythmic pattern feel energetic transforms a child's performance. Theory gives young musicians the vocabulary to interpret music thoughtfully rather than playing mechanically.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Getting Here from Bukit Panjang -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Easy to Reach</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Getting Here from Bukit Panjang
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <p class="text-base-600 mb-4">
              Patricia's Tengah studio is approximately 15 minutes from Bukit Panjang by car, heading south via Bukit Panjang Road and Dairy Farm Road. The route avoids major expressways and is generally smooth, making it a convenient drive even during after-school hours when most lessons take place.
            </p>
            <p class="text-base-600 mb-4">
              Families near Bukit Panjang MRT on the Downtown Line can also consider the MRT connection, with the Jurong Region Line providing access to Tengah as the new stations open. For theory-specific sessions, online lessons are a practical alternative — the written and analytical nature of theory translates well to video call format.
            </p>
            <p class="text-base-600">
              Whether your family lives near Senja, Jelapang, or the Greenridge and Zhenghua housing estates, Patricia is happy to discuss the best arrangement for your child's theory preparation.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-4">Transport Options</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By car:</strong> Around 15 minutes via Bukit Panjang Rd and Dairy Farm Rd</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By MRT:</strong> Downtown Line from Bukit Panjang MRT, connecting towards Tengah via Jurong Region Line</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">Online:</strong> Theory lessons available via video call — ideal for Bukit Panjang families with packed schedules</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- What Theory Lessons Cover -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Grade-by-Grade Breakdown</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            What Theory Lessons Cover
          </h2>
        </div>

        <div class="space-y-6">
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex flex-wrap gap-2 mb-3">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Grade 1</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Grade 2</span>
            </div>
            <h3 class="text-lg font-semibold text-base-900 mb-2">Building Blocks</h3>
            <p class="text-base-600 text-sm">
              These early grades lay the groundwork for everything that follows. Students learn to read and write confidently in treble and bass clefs, understand note values from semibreves to semiquavers and their corresponding rests, and work with simple time signatures (2/4, 3/4, 4/4). Key signatures up to two sharps and flats are introduced alongside essential Italian terms for tempo, dynamics, and expression. Patricia connects each concept to the pieces her Bukit Panjang students are already practising, so theory feels immediately relevant.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex flex-wrap gap-2 mb-3">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Grade 3</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Grade 4</span>
            </div>
            <h3 class="text-lg font-semibold text-base-900 mb-2">Deepening Understanding</h3>
            <p class="text-base-600 text-sm">
              The intermediate grades introduce compound time signatures (6/8, 9/8, 12/8), expand key signature knowledge to cover all major and minor keys, and develop the ability to identify and write intervals accurately. Students begin working with primary triads and basic harmony, learn transposition between closely related keys, and build a broader vocabulary of musical terms and ornaments. Patricia ensures her students see how these concepts explain the music they encounter in their piano or violin repertoire.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex flex-wrap gap-2 mb-3">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Grade 5</span>
            </div>
            <h3 class="text-lg font-semibold text-base-900 mb-2">Comprehensive Musicianship</h3>
            <p class="text-base-600 text-sm">
              Grade 5 is the culmination of the theory syllabus and covers substantial new ground: irregular time signatures (5/4, 7/8), reading in alto and tenor clefs, chord inversions and secondary triads, cadence identification and analysis, transposition at concert pitch for transposing instruments, and composing a short melody to a given opening. Patricia uses structured revision schedules and past ABRSM papers to ensure every student from Bukit Panjang enters the exam room well-prepared and confident.
            </p>
          </div>
        </div>

        <div class="text-center mt-8">
          <a href="/lessons/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            View Full Lesson Details
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Common Questions</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Music Theory FAQs
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="group bg-primary-50 rounded-xl">
              <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
                <span class="font-medium text-base-900 text-sm md:text-base pr-4">{faq.question}</span>
                <span class="text-primary-600 group-open:rotate-45 transition-transform text-xl flex-shrink-0">+</span>
              </summary>
              <div class="px-4 pb-4 text-base-600 text-sm">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Also Available -->
    <section class="py-6 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also available in Bukit Panjang:
          <a href="/piano-lessons-bukit-panjang/" class="text-primary-600 hover:underline">Piano Lessons</a> ·
          <a href="/violin-lessons-bukit-panjang/" class="text-primary-600 hover:underline">Violin Lessons</a> ·
          <a href="/music-lessons-bukit-panjang/" class="text-primary-600 hover:underline">Music Lessons</a> ·
          <a href="/abrsm-piano-lessons-bukit-panjang/" class="text-primary-600 hover:underline">ABRSM Piano</a> ·
          <a href="/abrsm-violin-lessons-bukit-panjang/" class="text-primary-600 hover:underline">ABRSM Violin</a>
        </p>
      </div>
    </section>

    <!-- Also Serving Nearby -->
    <section class="py-8 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also serving families in
          <a href="/music-theory-lessons-choa-chu-kang/" class="text-primary-600 hover:underline">Choa Chu Kang</a> and
          <a href="/music-theory-lessons-singapore/" class="text-primary-600 hover:underline">across Singapore</a>.
          <a href="/lessons/" class="text-primary-600 hover:underline">View all lesson details</a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-white border-t border-primary-100">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-3">
          Build a Strong Musical Foundation
        </h2>
        <p class="text-base-600 mb-6">Get in touch with Patricia to discuss music theory preparation for your child in Bukit Panjang. Free consultation — no commitment needed.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/contact/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            Book a Trial
