---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import RelatedReading from '../components/RelatedReading.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'

const faqs = [
  {
    question: "Where exactly in Tengah is Patricia's studio?",
    answer: "Patricia's home studio is located within Tengah's residential precinct. As a fellow Tengah resident, she's within walking or short cycling distance for most families in the Plantation District, Garden District, and surrounding BTO developments. No driving or MRT transfers needed — just head over on foot or by bicycle."
  },
  {
    question: "Is Tengah too new for established music teachers?",
    answer: "Quite the opposite. Patricia moved to Tengah early and has been building her teaching practice here as the town grows. Being one of the first dedicated children's music teachers in Tengah means she understands the community — the young families settling in, the lack of nearby music schools, and the demand for quality local lessons. Your child gets an experienced teacher without leaving the neighbourhood."
  },
  {
    question: "My child is only 4 — is that too young for piano?",
    answer: "Not at all. Age four is when many children are ready for structured piano lessons. Patricia's Bachelor's degree in Early Childhood Education means she's specifically trained to work with very young learners. She uses age-appropriate activities that build hand coordination, listening skills, and musical awareness. The initial consultation helps confirm your child's readiness before committing."
  },
  {
    question: "Will there be more music options in Tengah as the town develops?",
    answer: "Commercial music schools may eventually open as Tengah's town centre takes shape. But Patricia offers something different — private, one-to-one lessons in a calm home studio, tailored entirely to your child. No class sizes to worry about, no impersonal rotation of teachers. The personal attention and consistency she provides is something larger schools rarely match."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}
---

<BaseLayout
  title="Piano Lessons for Children in Tengah | Music with Pat"
  description="Piano lessons for children in Tengah, Singapore. Patricia's home studio is right here in Tengah — no travel needed."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Piano Lessons",
      "name": "Piano Lessons for Children in Tengah",
      "provider": {
        "@type": "LocalBusiness",
        "@id": "https://www.musicwithpat.com/#business",
        "name": "Music with Pat"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Tengah, Singapore"
      },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedMinAge": 4
      },
      "description": "Patient, child-centred piano lessons for children in Tengah, Singapore. Patricia's home studio is located right in Tengah — your local piano teacher with ABRSM preparation."
    }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  </Fragment>

  <Header />
  <Breadcrumbs items={[{ label: 'Piano Lessons Tengah' }]} />

  <main>
    <!-- Hero -->
    <section class="py-10 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">Right Here in Tengah</p>
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-serif font-semibold text-base-900 mb-4">
          Piano Lessons for Children in Tengah
        </h1>
        <p class="text-base-600 text-lg md:text-xl max-w-2xl mx-auto mb-6">
          Tengah is Singapore's newest town — and it deserves a dedicated music teacher. Patricia's home studio is right here in Tengah, which means no commute, no traffic, and no rushing across town for your child's piano lesson. As young families settle into the Plantation District, Garden District, and surrounding BTO developments, Patricia is already here, offering patient, child-centred piano lessons just minutes from your doorstep.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact/" class="px-6 py-3 bg-primary-600 text-white font-medium rounded-xl hover:bg-primary-700 transition-colors">Book a Trial</a>
          <a href="https://wa.me/6583898853?text=Hi%20Ms%20Pat%2C%20I'd%20like%20to%20enquire%20about%20piano%20lessons." target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-whatsapp text-white font-medium rounded-xl hover:bg-whatsapp-dark transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </section>

    <!-- About Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2">
            <img
              src="/patricia-piano-lessons.webp"
                width="1024"
                height="1280"
              alt="Patricia - Piano Teacher for Children in Tengah"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full"
              loading="lazy"
            />
          </div>
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2">Meet the Teacher</p>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">
              About Patricia
            </h2>
            <p class="text-base-600 mb-4">
              Patricia is a Tengah resident and your neighbourhood piano teacher. With over a decade of experience teaching children, she set up her home studio right here in Tengah so that local families can access quality piano education without leaving the estate.
            </p>
            <p class="text-base-600 mb-4">
              Her Bachelor's degree in Early Childhood Education with Music Education gives her a deep understanding of how young children learn. She combines proper piano pedagogy with genuine insight into child development — knowing when to introduce new challenges, when to consolidate, and how to keep a young learner engaged throughout each session.
            </p>
            <p class="text-base-600 mb-6">
              Patricia's teaching style is warm, structured, and attentive. She builds strong fundamentals from the start — posture, hand position, reading notation — while making sure your child enjoys the process. Whether your child is a complete beginner or working towards an ABRSM grade, she tailors every lesson to who they are and where they're at.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">B.Ed Early Childhood & Music</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">10+ Years Experience</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">ABRSM Preparation</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Ages 4+</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Why Tengah Families Choose Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Why Families Trust Patricia</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Why Tengah Families Choose Patricia
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Your Neighbourhood Piano Teacher</h3>
                <p class="text-base-600 text-sm">Patricia lives and teaches in Tengah. There's no cross-town commute, no fighting for parking at a shopping mall music school. Her studio is within walking or cycling distance for most Tengah residents — making weekly lessons easy to maintain, even on busy school days.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Early Childhood Expertise</h3>
                <p class="text-base-600 text-sm">Patricia's Bachelor's degree in Early Childhood Education with Music Education means she understands both the musical and developmental sides of teaching young children. She reads each student's temperament and adjusts her approach — a skill built on formal training, not trial and error.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">ABRSM When It Makes Sense</h3>
                <p class="text-base-600 text-sm">Structured exam preparation is available for students who benefit from clear milestones and goals. But Patricia never forces the exam route. Some children thrive building repertoire and confidence at their own pace, and she's equally comfortable guiding that journey. She'll recommend what genuinely suits your child.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Growing with Tengah</h3>
                <p class="text-base-600 text-sm">As Tengah develops — with the Jurong Region Line on the way and new amenities opening up — Patricia is already established here, building a community of young musicians in the neighbourhood. Your child won't just be learning piano; they'll be part of Tengah's first generation of music students.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Your Local Studio -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">No Commute Needed</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Your Local Studio
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <p class="text-base-600 mb-4">
              Unlike families from other towns who need to drive or take the MRT to reach the studio, Tengah residents have Patricia right on their doorstep. Her home studio is within the Tengah residential area, making it a short walk or bicycle ride for most families in the Plantation District, Garden District, and Park District.
            </p>
            <p class="text-base-600 mb-4">
              This proximity makes a real difference to weekly routines. There's no need to factor in travel time, parking, or traffic — your child can head to their lesson and be back home quickly. It also means last-minute schedule adjustments are easier to manage.
            </p>
            <p class="text-base-600">
              For Tengah families who still prefer lessons at home, house visits are available throughout the estate. Patricia is flexible and will work with whatever arrangement suits your family best.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-4">The Local Advantage</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">On foot:</strong> Walking distance for most Tengah residents — no car needed</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By bicycle:</strong> Tengah's cycling paths connect directly to the studio area</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">Zero commute:</strong> No expressways, no MRT transfers, no traffic to navigate</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">House visits:</strong> Also available throughout Tengah if you prefer lessons at home</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- What Lessons Look Like -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Lesson Structure</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            What Lessons Look Like
          </h2>
        </div>

        <div class="space-y-4 text-base-600">
          <p>
            Lessons are private, one-to-one sessions lasting 45 to 60 minutes. For younger beginners, Patricia starts with shorter sessions and gradually extends them as the child's focus develops. Every lesson is shaped around your child's current level and learning style.
          </p>
          <p>
            Each session covers a blend of practical playing, sight-reading, aural training, and music theory. Patricia keeps things varied so children stay engaged — moving between scales, repertoire pieces, and ear training exercises in a way that builds well-rounded musicianship without feeling repetitive.
          </p>
          <p>
            Being in Tengah means your child arrives fresh and ready to learn — no tired, restless car rides beforehand. That small difference in energy and focus adds up over weeks and months of lessons.
          </p>
        </div>

        <div class="text-center mt-8">
          <a href="/lessons/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            View Full Lesson Details
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Common Questions</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="group bg-primary-50 rounded-xl">
              <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
                <span class="font-medium text-base-900 text-sm md:text-base pr-4">{faq.question}</span>
                <span class="text-primary-600 group-open:rotate-45 transition-transform text-xl flex-shrink-0">+</span>
              </summary>
              <div class="px-4 pb-4 text-base-600 text-sm">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Also Available -->
    <section class="py-6 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also in Tengah:
          <a href="/violin-lessons-tengah/" class="text-primary-600 hover:underline">violin lessons in Tengah</a> ·
          <a href="/music-lessons-tengah/" class="text-primary-600 hover:underline">Music Lessons</a> ·
          <a href="/abrsm-piano-lessons-tengah/" class="text-primary-600 hover:underline">ABRSM Piano</a> ·
          <a href="/music-theory-lessons-tengah/" class="text-primary-600 hover:underline">Music Theory</a>
        </p>
      </div>
    </section>

    <!-- Also Serving Nearby -->
    <section class="py-8 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also serving families in
          <a href="/piano-lessons-jurong-west/" class="text-primary-600 hover:underline">Jurong West</a>,
          <a href="/piano-lessons-bukit-batok/" class="text-primary-600 hover:underline">Bukit Batok</a>,
          <a href="/piano-lessons-bukit-panjang/" class="text-primary-600 hover:underline">Bukit Panjang</a>, and
          <a href="/piano-lessons-choa-chu-kang/" class="text-primary-600 hover:underline">Choa Chu Kang</a>.
          <a href="/lessons/" class="text-primary-600 hover:underline">View all lesson details</a>.
        </p>
      </div>
    </section>

    <!-- Parent Testimonial -->
    <section class="py-12 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">From Parents</p>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-6">
          What Parents Say
        </h2>
        <div class="space-y-4">
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary-100">
            <p class="text-base-700 italic mb-3">"Pat has such a gentle way with children. My daughter looks forward to her lessons every week! She's made incredible progress in just 6 months."</p>
            <p class="text-base-500 text-sm">— Sarah L., Mother of Emily, Age 7</p>
          </div>
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary-100">
            <p class="text-base-700 italic mb-3">"We tried other teachers before, but Pat's nurturing approach finally got my son excited about piano. He now practices without being asked!"</p>
            <p class="text-base-500 text-sm">— Michelle T., Mother of Ryan, Age 9</p>
          </div>
        </div>
        <a href="/testimonials/" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1 mt-4">
          Read all testimonials
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-primary-50 border-t border-primary-100">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-3">
          Start Your Child's Piano Journey
        </h2>
        <p class="text-base-600 mb-6">Get in touch with Patricia for a free consultation to discuss your child's interests and what lessons could look like. No commitment needed.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/contact/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            Book a Trial
          </a>
          <a
            href="https://wa.me/6583898853?text=Hi%20Ms%20Pat%2C%20I'd%20like%20to%20enquire%20about%20piano%20lessons."
            target="_blank"
            rel="noopener noreferrer"
