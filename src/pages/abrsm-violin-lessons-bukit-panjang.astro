---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'

const faqs = [
  {
    question: "What size violin does my child need for ABRSM exams?",
    answer: "Violin sizing depends on your child's arm length, not their age. Patricia will measure your child at the first lesson and recommend the correct size — typically 1/8 or 1/4 for younger beginners, progressing through 1/2 and 3/4 before reaching a full-size instrument around age 12 or 13. Playing on the wrong size violin makes proper technique much harder and can lead to tension injuries, so getting this right matters from the start."
  },
  {
    question: "How does ABRSM assess bow control and tone production in violin exams?",
    answer: "Examiners listen for a consistent, well-produced tone across all strings and dynamic levels. This includes smooth bow changes, controlled bow distribution, and the ability to vary tone colour to suit the character of each piece. Patricia builds bow technique systematically from the earliest grades, so students develop the kind of natural, confident bow arm that examiners reward with higher marks."
  },
  {
    question: "Is intonation heavily penalised in ABRSM violin exams?",
    answer: "Intonation is one of the most scrutinised aspects of any string exam. Consistently out-of-tune playing will significantly lower marks across all three pieces. Patricia addresses intonation from day one, training students to listen critically and self-correct. She uses scales and technical exercises to build reliable finger placement, and her ear-training work helps students develop the internal pitch reference that underpins accurate intonation."
  },
  {
    question: "When should my child start preparing for ABRSM violin Grade 1?",
    answer: "Most children benefit from at least six to twelve months of foundational work before attempting Grade 1. This allows time to establish a secure bow hold, develop basic left-hand technique, and build the reading skills needed for the exam. Patricia assesses each child individually during a free consultation and will give you an honest timeline based on their current ability and practice habits."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}
