---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import WhatsAppCTA from '../components/WhatsAppCTA.astro'

const waHref = "https://wa.me/6583898853?text=Hi%20Ms%20Pat%2C%20I'd%20like%20to%20enquire%20about%20music%20lessons."

// Real reviews — from Patricia's testimonials page.
const reviews = [
  { stars: 5, text: "We've had a great experience with teacher Patricia. She is patient, kind, and knows how to keep kids engaged and motivated during lessons. We've seen clear improvement in their playing skills and their discipline.", name: "Gene", relation: "Mother of Adam and Renee" },
  { stars: 5, text: "Pat has such a gentle way with children. My daughter looks forward to her lessons every week! She's made incredible progress in just 6 months.", name: "Sarah L.", relation: "Mother of Emily, Age 7" },
  { stars: 5, text: "We tried other teachers before, but Pat's nurturing approach finally got my son excited about piano. He now practices without being asked!", name: "Michelle T.", relation: "Mother of Ryan, Age 9" },
  { stars: 5, text: "Pat prepared my daughter for her ABRSM Grade 3 exam and she passed with distinction! Highly recommend for anyone looking for quality piano lessons.", name: "Jennifer C.", relation: "Mother of Sophie, Age 11" }
]
---

<BaseLayout
  title="Piano & Violin Lessons in Singapore — Tengah Studio | Music with Pat"
  description="Piano and violin lessons for children and adults in Singapore. Patricia teaches from her Tengah studio and via home visits across west Singapore — ABRSM prep or lessons for pure enjoyment."
>
  <Header currentPage="/" />

  <main id="main-content">
  <!-- Hero Section (full-bleed) -->
  <section class="relative overflow-hidden md:min-h-[calc(100vh-6rem)] flex items-center px-6 md:px-12 py-20 md:py-6">
    <div class="hero-bg absolute inset-0" role="img" aria-label="Patricia, piano and violin teacher in Singapore"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#2d1a0e]/62 via-[#2d1a0e]/36 to-[#2d1a0e]/10"></div>

    <div class="hero-copy relative z-10 w-full max-w-6xl mx-auto">
      <div class="max-w-2xl text-center md:text-left mx-auto md:mx-0">
        <p class="text-primary-200 font-medium mb-3">Where Music Grows Naturally</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-semibold text-white mb-5 leading-tight">
          Piano &amp; Violin Lessons for Children &amp; Adults in Singapore
        </h1>
        <p class="text-white/90 text-lg md:text-xl mb-8 max-w-xl mx-auto md:mx-0">
          Patricia's warm, one-to-one teaching helps children and adults discover the joy of music — at a pace that's right for them. From her Tengah studio, or home visits across west Singapore.
        </p>

        <div class="flex flex-col sm:flex-row justify-center md:justify-start gap-3 mb-6">
          <a href="/contact/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            Book a Trial
          </a>
          <a href={waHref} target="_blank" rel="noopener noreferrer"
            class="px-8 py-4 bg-whatsapp text-white font-medium rounded-full hover:bg-whatsapp-dark transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Pat
          </a>
        </div>

        <div class="flex flex-wrap justify-center md:justify-start items-center gap-x-5 gap-y-2 text-sm text-white/85">
          <span class="inline-flex items-center gap-1"><span class="text-primary-300">★★★★★</span> Loved by families across Singapore</span>
          <span class="text-white/40">•</span>
          <span>10+ years teaching</span>
          <span class="text-white/40">•</span>
          <span>ABRSM exam prep</span>
          <span class="text-white/40">•</span>
          <span>Home visits available</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About Summary -->
  <section class="py-16 md:py-28 px-6 md:px-12 bg-primary-50">
    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="md:order-2">
          <img
            src="/patricia-piano-lessons.webp"
            alt="Patricia - Piano Teacher for Children in Singapore"
            class="aspect-[4/5] object-cover object-top rounded-2xl w-full"
            loading="lazy"
            width="1024"
            height="1280"
          />
        </div>
        <div class="md:order-1">
          <p class="text-primary-600 font-medium mb-2">About</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">
            Meet Patricia
          </h2>
          <p class="text-base-600 mb-4">
            Patricia is a piano teacher based in Tengah, Singapore with over 10 years of experience teaching young children from age four and up. Her teaching approach is gentle, patient, and encouraging.
          </p>
          <p class="text-base-600 mb-6">
            With a Bachelor's degree in Early Childhood Education with Music Education, Patricia designs lessons that feel safe, enjoyable, and meaningful for young learners. Her home studio is conveniently located for families in Tengah, Jurong West, Bukit Batok, Bukit Timah, and Choa Chu Kang.
          </p>

          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-2 bg-white text-primary-700 rounded-full text-sm font-medium">
              B.Ed Early Childhood & Music
            </span>
            <span class="px-3 py-2 bg-white text-primary-700 rounded-full text-sm font-medium">
              10+ Years Teaching
            </span>
          </div>

          <a href="/about/" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1">
            Learn more about Patricia
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lessons Summary -->
  <section class="py-12 md:py-20 px-6 md:px-12 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <p class="text-primary-600 font-medium mb-2">Teaching Philosophy</p>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
          Your Musical Journey
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        <div class="timeline-step text-center">
          <div class="w-10 h-10 rounded-full bg-primary-600 text-white flex items-center justify-center font-semibold mx-auto mb-3">1</div>
          <svg class="w-6 h-6 text-primary-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z" /></svg>
          <h3 class="text-sm md:text-base font-semibold text-base-900 mb-1">Foundation</h3>
          <p class="text-base-600 text-xs md:text-sm">Understanding key musical elements. Developing solid piano technique.</p>
        </div>
        <div class="timeline-step text-center">
          <div class="w-10 h-10 rounded-full bg-primary-600 text-white flex items-center justify-center font-semibold mx-auto mb-3">2</div>
          <svg class="w-6 h-6 text-primary-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
          <h3 class="text-sm md:text-base font-semibold text-base-900 mb-1">Development</h3>
          <p class="text-base-600 text-xs md:text-sm">Sight-reading. Aural training. Music theory. Practical piano playing.</p>
        </div>
        <div class="timeline-step text-center">
          <div class="w-10 h-10 rounded-full bg-primary-600 text-white flex items-center justify-center font-semibold mx-auto mb-3">3</div>
          <svg class="w-6 h-6 text-primary-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>
          <h3 class="text-sm md:text-base font-semibold text-base-900 mb-1">Mastery</h3>
          <p class="text-base-600 text-xs md:text-sm">Curated repertoire to challenge and inspire. Developing musical expression.</p>
        </div>
        <div class="timeline-step text-center">
          <div class="w-10 h-10 rounded-full bg-primary-600 text-white flex items-center justify-center font-semibold mx-auto mb-3">4</div>
          <svg class="w-6 h-6 text-primary-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M18.75 4.236c.982.143 1.954.317 2.916.52A6.003 6.003 0 0 1 16.27 9.728M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228m0 0a6.023 6.023 0 0 1-2.77.896M7.73 9.728a6.023 6.023 0 0 0 2.77.896m0 0c.177.02.357.03.54.03.184 0 .363-.01.54-.03m-1.08 0a48.278 48.278 0 0 0 1.08 0m-1.08 0c.183 1.14.224 2.178.121 3.172m1.08-3.172a48.394 48.394 0 0 1-.12 3.172" /></svg>
          <h3 class="text-sm md:text-base font-semibold text-base-900 mb-1">Achievement</h3>
          <p class="text-base-600 text-xs md:text-sm">ABRSM examinations. Studio recitals and performance opportunities.</p>
        </div>
      </div>

      <div class="text-center mt-6">
        <a href="/lessons/" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1">
          Learn more about our lessons
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials (conveyor) -->
  <section class="py-12 md:py-24 bg-primary-50 overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      <div class="text-center mb-10">
        <p class="text-primary-600 font-medium mb-2">Parent Testimonials</p>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">Loved by parents like you</h2>
      </div>
    </div>
    <div class="marquee">
      <div class="marquee__track">
        <ul class="marquee__group">
          {reviews.map(r => (
            <li class="marquee__card bg-white rounded-2xl p-6 border border-primary-100 flex flex-col">
              <div class="text-primary-500 mb-3" aria-label={`${r.stars} out of 5 stars`}>★★★★★</div>
              <blockquote class="text-base-600 text-sm mb-4 flex-1">“{r.text}”</blockquote>
              <figcaption class="text-sm font-semibold text-base-900">{r.name}<span class="font-normal text-base-600">, {r.relation}</span></figcaption>
            </li>
          ))}
        </ul>
        <ul class="marquee__group" aria-hidden="true">
          {reviews.map(r => (
            <li class="marquee__card bg-white rounded-2xl p-6 border border-primary-100 flex flex-col">
              <div class="text-primary-500 mb-3">★★★★★</div>
              <blockquote class="text-base-600 text-sm mb-4 flex-1">“{r.text}”</blockquote>
              <figcaption class="text-sm font-semibold text-base-900">{r.name}<span class="font-normal text-base-600">, {r.relation}</span></figcaption>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="text-center mt-8 px-6">
      <a href="/testimonials/" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1">
        Read all testimonials
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>
  </section>

  <!-- Referral Section -->
  <section class="py-10 md:py-16 px-6 md:px-12 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-3">
        Refer a Friend!
      </h2>
      <p class="text-base-600 mb-6">
        Share the joy of learning music with Patricia if you like her lessons.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a
          href="https://wa.me/?text=Check%20out%20Music%20with%20Pat%20for%20piano%20lessons!%20https://www.musicwithpat.com/"
          target="_blank"
          class="px-6 py-3 bg-whatsapp text-white rounded-xl hover:bg-whatsapp-dark flex items-center justify-center gap-2 font-medium"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Share on WhatsApp
        </a>
        <button
          id="copy-link-btn"
          class="px-6 py-3 bg-base-800 text-white rounded-xl hover:bg-base-900 flex items-center justify-center gap-2 font-medium"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          Copy Link
        </button>
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section class="py-12 md:py-20 px-6 md:px-12 bg-primary-50">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <p class="text-primary-600 font-medium mb-2">Serving Families Across West Singapore</p>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
          Find Lessons Near You
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/music-lessons-tengah/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Tengah</p>
          <p class="text-base-500 text-xs">Studio location</p>
        </a>
        <a href="/music-lessons-bukit-panjang/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Bukit Panjang</p>
          <p class="text-base-500 text-xs">~15 min drive</p>
        </a>
        <a href="/music-lessons-choa-chu-kang/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Choa Chu Kang</p>
          <p class="text-base-500 text-xs">~10 min drive</p>
        </a>
        <a href="/music-lessons-jurong-west/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Jurong West</p>
          <p class="text-base-500 text-xs">~10 min drive</p>
        </a>
        <a href="/music-lessons-jurong-east/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Jurong East</p>
          <p class="text-base-500 text-xs">~15 min drive</p>
        </a>
        <a href="/music-lessons-bukit-batok/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Bukit Batok</p>
          <p class="text-base-500 text-xs">~10 min drive</p>
        </a>
        <a href="/music-lessons-bukit-timah/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Bukit Timah</p>
          <p class="text-base-500 text-xs">~15 min drive</p>
        </a>
        <a href="/music-lessons-clementi/" class="bg-white rounded-xl p-4 border border-primary-100 hover:border-primary-300 transition-colors text-center group">
          <p class="font-semibold text-base-900 group-hover:text-primary-600 mb-1">Clementi</p>
          <p class="text-base-500 text-xs">~15 min drive</p>
        </a>
      </div>

      <p class="text-center text-base-500 text-sm mt-6">
        Right here in Tengah:
        <a href="/piano-lessons-tengah/" class="text-primary-600 hover:underline">piano lessons in Tengah</a>,
        <a href="/violin-lessons-tengah/" class="text-primary-600 hover:underline">violin lessons in Tengah</a> and
        <a href="/music-lessons-tengah/" class="text-primary-600 hover:underline">music lessons in Tengah</a>.
      </p>
      <p class="text-center text-base-500 text-sm mt-2">
        Popular nearby:
