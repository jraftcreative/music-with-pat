---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'

const faqs = [
  {
    question: "What size violin does my child need?",
    answer: "Children use fractional-size violins that match their arm length and hand size. Most four- and five-year-olds start on a 1/4 size, progressing through 1/2 and 3/4 as they grow, before eventually reaching a full-size instrument. Patricia will measure your child during the initial consultation and recommend the right size. She can also advise on where to rent or buy a suitable instrument in Singapore."
  },
  {
    question: "Is the studio really within walking distance for Tengah residents?",
    answer: "Yes. Patricia's home studio is within the Tengah residential area. For families in the Plantation District, Garden District, and Park District, it's a short walk or bicycle ride — no driving required. Tengah's network of pedestrian paths and cycling routes makes getting to the studio straightforward, even for parents with young children in tow."
  },
  {
    question: "How does Patricia handle the early stages of violin when it can sound quite rough?",
    answer: "The early weeks of violin produce sounds that test everyone's patience — Patricia understands this well. She focuses on building correct bow hold and posture first, using open string exercises that develop a clean, even tone before introducing finger placement. She keeps early lessons varied with listening activities, rhythm games, and short playing bursts so children stay motivated through the challenging initial period."
  },
  {
    question: "Are there other violin teachers in Tengah?",
    answer: "As a newly developing town, Tengah doesn't yet have commercial music schools or a large pool of private teachers. Patricia is one of the few dedicated children's violin teachers based in the area. Being a Tengah resident herself, she's committed to the community and has been building her local practice as the town grows around her."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}
---

<BaseLayout
  title="Violin Lessons for Children in Tengah | Music with Pat"
  description="Violin lessons for children in Tengah, Singapore. Patricia's home studio is right here in Tengah — no travel needed. Patient, child-centred teaching with ABRSM preparation and fractional-size violins. Ages 4+."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Violin Lessons",
      "name": "Violin Lessons for Children in Tengah",
      "provider": {
        "@type": "LocalBusiness",
        "@id": "https://www.musicwithpat.com/#business",
        "name": "Music with Pat"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Tengah, Singapore"
      },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedMinAge": 4
      },
      "description": "Patient, child-centred violin lessons for children in Tengah, Singapore. Patricia's home studio is located right in Tengah — your local violin teacher with ABRSM preparation."
    }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  </Fragment>

  <Header />
  <Breadcrumbs items={[{ label: 'Violin Lessons Tengah' }]} />

  <main>
    <!-- Hero -->
    <section class="py-10 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">Right Here in Tengah</p>
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-serif font-semibold text-base-900 mb-4">
          Violin Lessons for Children in Tengah
        </h1>
        <p class="text-base-600 text-lg md:text-xl max-w-2xl mx-auto mb-6">
          Finding a violin teacher shouldn't mean travelling across Singapore. Patricia's studio is right here in Tengah — your neighbourhood violin teacher in Singapore's newest town. As young families fill the Plantation District, Garden District, and surrounding BTO estates, Patricia offers patient, structured violin lessons for children just a short walk from home. No long commute, no traffic stress, just quality music education on your doorstep.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact/" class="px-6 py-3 bg-primary-600 text-white font-medium rounded-xl hover:bg-primary-700 transition-colors">Book a Trial</a>
          <a href="https://wa.me/6583898853?text=Hi%20Pat!%20I'm%20interested%20in%20violin%20lessons%20for%20my%20child%20in%20Tengah." target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-green-500 text-white font-medium rounded-xl hover:bg-green-600 transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </section>

    <!-- About Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2">
            <img
              src="/patricia-piano-lessons.webp"
                width="1024"
                height="1280"
              alt="Patricia - Violin Teacher for Children in Tengah"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full"
              loading="lazy"
            />
          </div>
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2">Meet the Teacher</p>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">
              About Patricia
            </h2>
            <p class="text-base-600 mb-4">
              Patricia is a Tengah-based music teacher with over a decade of experience teaching violin to children. She established her home studio here so that families in the neighbourhood can access dedicated violin instruction without the hassle of travelling to commercial music schools in other towns.
            </p>
            <p class="text-base-600 mb-4">
              Her Bachelor's degree in Early Childhood Education with Music Education equips her with both strong violin pedagogy and a genuine understanding of child development. She knows that learning violin is physically demanding for young children — the posture, the bow hold, the fine motor coordination — and she introduces each element at a pace that respects how small bodies and developing minds actually work.
            </p>
            <p class="text-base-600 mb-6">
              Patricia is encouraging without being passive. She holds her students to a standard while making sure the process is enjoyable. From first bow strokes on a fractional-size violin through to confident playing and ABRSM exam preparation, she shapes each lesson around the individual child in front of her.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">B.Ed Early Childhood & Music</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">10+ Years Experience</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">ABRSM Preparation</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Ages 4+</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Why Tengah Families Choose Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Why Families Trust Patricia</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Why Tengah Families Choose Patricia
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">A Violin Teacher in Your Neighbourhood</h3>
                <p class="text-base-600 text-sm">Patricia lives and teaches in Tengah. Her studio is within walking or cycling distance for most residents — no need to drive across town or navigate MRT transfers with a small child carrying a violin case. Weekly lessons become a simple, stress-free part of your routine.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Patient with Young Beginners</h3>
                <p class="text-base-600 text-sm">Violin is physically demanding for small children. Patricia understands the time it takes to develop proper bow hold, posture, and finger placement. She never rushes — building these foundations carefully so children develop good habits from day one, avoiding the corrections that become harder to fix later.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Trained in Child Development</h3>
                <p class="text-base-600 text-sm">Patricia's Bachelor's degree in Early Childhood Education with Music Education means she brings formal knowledge of how children learn into every violin lesson. She reads each student's readiness and adjusts her teaching — a skill that makes a real difference when working with four- and five-year-olds picking up an instrument for the first time.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Clear Progression Pathway</h3>
                <p class="text-base-600 text-sm">Whether your child is working towards ABRSM grades or building repertoire at their own pace, Patricia provides a structured pathway through each stage. She maps out milestones — from open strings and simple melodies through to confident, expressive playing — so parents and students can see real progress over time.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Your Local Studio -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">No Commute Needed</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Your Local Studio
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <p class="text-base-600 mb-4">
              Patricia's home studio is right within Tengah's residential area. For families in the Plantation District, Garden District, and Park District, it's a short walk or bicycle ride — there's no need to drive, find parking, or wrestle with public transport while carrying a violin case.
            </p>
            <p class="text-base-600 mb-4">
              This matters more than you might think. Violin students need to arrive calm and focused — not frazzled from a 30-minute car journey through evening traffic. The proximity of the studio means your child starts each lesson relaxed and ready to concentrate, which directly benefits their progress.
            </p>
            <p class="text-base-600">
              As the Jurong Region Line develops and Tengah's amenities expand, the neighbourhood will only become more connected. But for now, having a dedicated violin teacher already based here is a genuine advantage that Tengah families can make the most of.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-4">The Local Advantage</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">On foot:</strong> Walking distance for most Tengah residents — even with a violin in hand</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By bicycle:</strong> Use Tengah's cycling network to reach the studio quickly and easily</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">Zero commute:</strong> No expressways, no MRT transfers, no navigating traffic with an instrument</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">House visits:</strong> Also available throughout Tengah if you prefer lessons at home</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- What Lessons Look Like -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Lesson Structure</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            What Lessons Look Like
          </h2>
        </div>

        <div class="space-y-4 text-base-600">
          <p>
            Violin lessons are private, one-to-one sessions. Younger beginners typically start with 30-minute sessions that gradually extend to 45 or 60 minutes as their focus and physical stamina develop. Every lesson is tailored to where your child is in their learning journey.
          </p>
          <p>
            Each session builds on the fundamentals: correct posture and bow hold, tone production, scales, and repertoire. Patricia weaves in sight-reading and aural training so students develop well-rounded musicianship alongside their technical skills. For children on fractional-size violins, extra care goes into establishing comfortable physical habits that will serve them as they grow into larger instruments.
          </p>
          <p>
            Students preparing for ABRSM exams receive focused work across all components — scales, pieces, sight-reading, and aural tests. Those not on the exam track still follow a clear progression through carefully chosen repertoire that builds skill and maintains enthusiasm.
          </p>
        </div>

        <div class="text-center mt-8">
          <a href="/lessons/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            View Full Lesson Details
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Common Questions</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="group bg-primary-50 rounded-xl">
              <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
                <span class="font-medium text-base-900 text-sm md:text-base pr-4">{faq.question}</span>
                <span class="text-primary-600 group-open:rotate-45 transition-transform text-xl flex-shrink-0">+</span>
              </summary>
              <div class="px-4 pb-4 text-base-600 text-sm">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Also Available -->
    <section class="py-6 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also available in Tengah:
          <a href="/piano-lessons-tengah/" class="text-primary-600 hover:underline">Piano Lessons</a> ·
          <a href="/music-lessons-tengah/" class="text-primary-600 hover:underline">Music Lessons</a> ·
          <a href="/abrsm-violin-lessons-tengah/" class="text-primary-600 hover:underline">ABRSM Violin</a> ·
          <a href="/music-theory-lessons-tengah/" class="text-primary-600 hover:underline">Music Theory</a>
        </p>
      </div>
    </section>

    <!-- Also Serving Nearby -->
    <section class="py-8 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also serving families in
          <a href="/violin-lessons-jurong-west/" class="text-primary-600 hover:underline">Jurong West</a>,
          <a href="/violin-lessons-bukit-batok/" class="text-primary-600 hover:underline">Bukit Batok</a>,
          <a href="/violin-lessons-bukit-panjang/" class="text-primary-600 hover:underline">Bukit Panjang</a>, and
          <a href="/violin-lessons-choa-chu-kang/" class="text-primary-600 hover:underline">Choa Chu Kang</a>.
          <a href="/lessons/" class="text-primary-600 hover:underline">View all lesson details</a>.
        </p>
      </div>
    </section>

    <!-- Parent Testimonial -->
    <section class="py-12 md:py-20 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">From Parents</p>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-6">
          What Parents Say
        </h2>
        <div class="space-y-4">
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary-100">
            <p class="text-base-700 italic mb-3">"She is patient, kind, and knows how to keep kids engaged and motivated during lessons. Most importantly, Patricia understands how to work with different learning speeds and personalities, making each lesson productive and enjoyable."</p>
            <p class="text-base-500 text-sm">— Gene, Mother of Adam and Renee</p>
          </div>
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-primary-100">
            <p class="text-base-700 italic mb-3">"Pat prepared my daughter for her ABRSM Grade 3 exam and she passed with distinction! Highly recommend for anyone looking for quality music lessons."</p>
            <p class="text-base-500 text-sm">— Jennifer C., Mother of Sophie, Age 11</p>
          </div>
        </div>
        <a href="/testimonials/" class="text-primary-600 hover:text-primary-700 font-medium text-sm inline-flex items-center gap-1 mt-4">
          Read all testimonials
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-white border-t border-primary-100">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-3">
          Start Your Child's Violin Journey
        </h2>
        <p class="text-base-600 mb-6">Get in touch with Patricia for a free consultation to discuss your child's interests and what violin lessons could look like. No commitment needed.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/contact/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            Book a Trial
          </a>
          <a
            href="https://wa.me/6583898853?text=Hi%20Pat!%20I'm%20interested%20in%20violin%20lessons%20for%20my%20child%20in%20Tengah."
            target="_blank"
            rel="noopener noreferrer"
