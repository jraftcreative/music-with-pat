---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
import RelatedReading from '../components/RelatedReading.astro'

const faqs = [
  {
    question: "How far is Patricia's Tengah studio from Bukit Batok?",
    answer: "Tengah sits directly next to Bukit Batok, so the studio is roughly a 10-minute drive — whether you set off from Bukit Batok Central, the Bukit Batok East Avenue blocks, or the newer West Hill and West BrickVille estates off Bukit Batok Road. Families using public transport can travel from Bukit Batok MRT on the North-South Line, and Patricia also provides house visits right across Bukit Batok for families who prefer ABRSM lessons at home."
  },
  {
    question: "What does ABRSM exam preparation actually involve each week?",
    answer: "Each 45- to 60-minute lesson covers all four assessed components: pieces, scales and arpeggios, sight-reading, and aural tests. Patricia dedicates time to each area every week rather than cramming any single component near the exam date. This consistent, balanced approach builds the well-rounded musicianship that ABRSM examiners reward with higher marks."
  },
  {
    question: "How does Patricia handle the transition between ABRSM grades?",
    answer: "After completing one grade, Patricia uses the interim period to consolidate skills, address any weaknesses identified in the examiner's report, and introduce preparatory material for the next level. This transition phase is valuable because it allows students to absorb new technical demands gradually rather than jumping straight into a higher grade's requirements."
  },
  {
    question: "Does Patricia teach music theory as part of ABRSM piano lessons?",
    answer: "Yes, theory is woven into every lesson from the earliest grades. Patricia connects theoretical concepts — such as key signatures, time signatures, intervals, and musical terms — to the repertoire the student is currently playing. By the time students reach the higher grades, they have a solid theoretical foundation and are well prepared for the Grade 5 Theory exam that ABRSM requires before Grades 6 through 8."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
}
---

<BaseLayout
  title="ABRSM Piano Lessons in Bukit Batok | Music with Pat"
  description="ABRSM piano exam preparation for children in Bukit Batok, Singapore. Grade-by-grade preparation from Prep Test to Grade 8 at Patricia's Tengah studio, next door to Bukit Batok."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "ABRSM Piano Lessons",
      "name": "ABRSM Piano Lessons for Children in Bukit Batok",
      "provider": {
        "@type": "LocalBusiness",
        "@id": "https://www.musicwithpat.com/#business",
        "name": "Music with Pat"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Bukit Batok, Singapore"
      },
      "audience": {
        "@type": "PeopleAudience",
        "suggestedMinAge": 4
      },
      "description": "ABRSM piano exam preparation for children in Bukit Batok, Singapore. Covering practical pieces, scales, sight-reading, aural tests, and music theory from Prep Test through Grade 8."
    }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  </Fragment>

  <Header />
  <Breadcrumbs items={[{ label: 'ABRSM Piano Lessons Bukit Batok' }]} />

  <main>
    <!-- Hero -->
    <section class="py-10 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">Bukit Batok & Tengah</p>
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-serif font-semibold text-base-900 mb-4">
          ABRSM Piano Lessons for Children in Bukit Batok
        </h1>
        <p class="text-base-600 text-lg md:text-xl max-w-2xl mx-auto mb-6">
          Bukit Batok is one of Singapore's most settled family towns — a mature HDB estate framed by Bukit Batok Nature Park and the granite cliffs of Little Guilin at Bukit Batok Town Park, where families put down roots for the long term. Children here attend neighbourhood schools like Bukit View, Princess Elizabeth, and Keming Primary, and parents increasingly seek a structured extracurricular pathway that lasts. Patricia's Tengah studio sits right on Bukit Batok's doorstep — around 10 minutes away — offering dedicated ABRSM piano exam preparation from Prep Test through Grade 8.
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact/" class="px-6 py-3 bg-primary-600 text-white font-medium rounded-xl hover:bg-primary-700 transition-colors">Book a Trial</a>
          <a href="https://wa.me/6583898853?text=Hi%20Ms%20Pat%2C%20I'd%20like%20to%20enquire%20about%20ABRSM%20piano%20lessons." target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-whatsapp text-white font-medium rounded-xl hover:bg-whatsapp-dark transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </section>

    <!-- About Patricia -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2">
            <img
              src="/patricia-piano-lessons.webp"
                width="1024"
                height="1280"
              alt="Patricia - ABRSM Piano Teacher for Children in Bukit Batok"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full"
              loading="lazy"
            />
          </div>
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2">Meet the Teacher</p>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">
              About Patricia
            </h2>
            <p class="text-base-600 mb-4">
              Patricia has spent over a decade specialising in ABRSM piano preparation for young learners, consistently guiding students to Merit and Distinction results. Her approach treats each grade as an opportunity to deepen a child's overall musicianship, not simply to tick off syllabus requirements and move on.
            </p>
            <p class="text-base-600 mb-4">
              Her academic background — a Bachelor's degree in Early Childhood Education with a Music Education focus — equips her with both pedagogical depth and musical rigour. She applies developmental psychology principles to her lesson planning, understanding that a seven-year-old and a twelve-year-old require fundamentally different teaching strategies even when working towards the same grade.
            </p>
            <p class="text-base-600 mb-6">
              Based in neighbouring Tengah, Patricia is genuinely local to Bukit Batok, and a good number of her students are Bukit Batok families she prepares for their ABRSM grades. Parents find her structured yet warm teaching style a natural fit for their children. She keeps families closely informed through regular progress updates and is always available to discuss how things are going, what the next milestone is, and how best to support practice at home.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">B.Ed Early Childhood & Music</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">10+ Years Experience</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">ABRSM Specialist</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Tengah Studio</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Choose Patricia for ABRSM -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Why Families Trust Patricia</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Why Bukit Batok Families Choose Patricia for ABRSM
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Structured Preparation</h3>
                <p class="text-base-600 text-sm">Patricia builds a clear preparation framework for every grade, distributing attention evenly across pieces, technical work, sight-reading, and aural training. This balanced approach means students develop as well-rounded musicians rather than being strong in one area while falling short in another — exactly what ABRSM examiners look for.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Theory Integration</h3>
                <p class="text-base-600 text-sm">Theory knowledge is developed alongside practical playing, not as a bolt-on extra. Patricia connects concepts like key signatures, intervals, and form to the music students are actually learning, making theory feel relevant and manageable. This proactive approach ensures the Grade 5 Theory requirement is met smoothly when the time comes.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Exam Confidence</h3>
                <p class="text-base-600 text-sm">Patricia systematically removes the unknowns that cause exam anxiety. Through timed mock exams, performance walkthroughs, and discussions about what happens in the exam room, children arrive on the day feeling prepared and composed. This confidence is reflected in their ability to perform at their best when it counts.</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <div class="flex items-start gap-4">
              <svg class="w-7 h-7 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 0-.668-.668 1.667 1.667 0 0 1-1.667-1.667V7.575a1.575 1.575 0 0 0-3.15 0" /></svg>
              <div>
                <h3 class="text-lg font-semibold text-base-900 mb-2">Individual Pacing</h3>
                <p class="text-base-600 text-sm">Patricia matches the pace of instruction to each student's development. She observes how quickly a child absorbs new material, adjusts her expectations accordingly, and only enters them for exams when they are truly ready. This respectful, individualised approach produces stronger results and keeps children motivated throughout their ABRSM journey.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Getting Here from Bukit Batok -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Easy to Reach</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            Getting Here from Bukit Batok
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <p class="text-base-600 mb-4">
              Because Tengah sits directly next to Bukit Batok, Patricia's studio is genuinely close — roughly a 10-minute drive whether you set off from Bukit Batok Central, the Bukit Batok East Avenue blocks, or the newer flats off Bukit Batok Road. The route is short and dependable even during typical weekday afternoon traffic.
            </p>
            <p class="text-base-600 mb-4">
              Many Bukit Batok families schedule their child's lesson around the school run, since neighbourhood schools like Bukit View, Princess Elizabeth, and Keming Primary are close at hand. After-school weekday slots and Saturday morning sessions are popular choices for families working around packed school and CCA timetables.
            </p>
            <p class="text-base-600">
              Patricia also visits homes right across Bukit Batok — from the established Bukit Batok Street estates and the East and West Avenue blocks to the newer West Hill and West BrickVille flats. Home-based ABRSM lessons are structured identically to studio sessions, ensuring your child receives the same thorough preparation regardless of where the lesson takes place.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-4">Transport Options</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By car:</strong> Around 10 minutes — Tengah is directly adjacent to Bukit Batok</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By MRT:</strong> North-South Line from Bukit Batok MRT, towards the Tengah side of town</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">By bus:</strong> Multiple services from Bukit Batok bus interchange connect towards Tengah and the surrounding estates</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                <span class="text-base-600 text-sm"><strong class="text-base-900">House visits:</strong> Available across Bukit Batok Central, East &amp; West Avenue estates, West Hill and West BrickVille</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ABRSM Exam Preparation -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Lesson Focus</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            What ABRSM Exam Preparation Looks Like
          </h2>
        </div>

        <div class="space-y-4 text-base-600">
          <p>
            ABRSM preparation lessons with Patricia run 45 to 60 minutes and follow a carefully considered structure. The session opens with technical exercises — the scales, arpeggios, and broken chords specified for the current grade — before moving into detailed work on the three exam pieces.
          </p>
          <p>
            Patricia approaches repertoire with genuine musicianship, helping students understand the character of each piece rather than simply playing the right notes. She discusses phrasing, dynamics, and stylistic context in terms children can grasp, building the kind of expressive playing that earns strong marks. Piece selection is tailored to each student's strengths and areas for growth.
          </p>
          <p>
            Sight-reading and aural training are standard features of every lesson. Patricia treats these as skills that develop best through brief, consistent practice rather than last-minute preparation. For students at Grade 4 and above, theory discussions are woven into the lesson — analysing the key of a piece, identifying intervals within the music, recognising cadences and form — connecting written theory to lived musical experience.
          </p>
        </div>

        <div class="text-center mt-8">
          <a href="/lessons/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            View Full Lesson Details
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Common Questions</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">
            ABRSM Piano FAQs — Bukit Batok
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="group bg-primary-50 rounded-xl">
              <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
                <span class="font-medium text-base-900 text-sm md:text-base pr-4">{faq.question}</span>
                <span class="text-primary-600 group-open:rotate-45 transition-transform text-xl flex-shrink-0">+</span>
              </summary>
              <div class="px-4 pb-4 text-base-600 text-sm">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Also Available -->
    <section class="py-6 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also available in Bukit Batok:
          <a href="/piano-lessons-bukit-batok/" class="text-primary-600 hover:underline">Piano Lessons</a> ·
          <a href="/violin-lessons-bukit-batok/" class="text-primary-600 hover:underline">Violin Lessons</a> ·
          <a href="/music-lessons-bukit-batok/" class="text-primary-600 hover:underline">Music Lessons</a> ·
          <a href="/music-theory-lessons-bukit-batok/" class="text-primary-600 hover:underline">Music Theory</a> ·
          <a href="/abrsm-violin-lessons-bukit-batok/" class="text-primary-600 hover:underline">ABRSM Violin</a>
        </p>
      </div>
    </section>

    <!-- Also Serving Nearby -->
    <section class="py-8 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-base-600 text-sm">
          Also serving families in
          <a href="/abrsm-piano-lessons-bukit-panjang/" class="text-primary-600 hover:underline">Bukit Panjang</a> and
          <a href="/abrsm-piano-lessons-choa-chu-kang/" class="text-primary-600 hover:underline">Choa Chu Kang</a>.
          See all the <a href="/areas/" class="text-primary-600 hover:underline">areas we serve</a>, or
          <a href="/abrsm-piano-lessons-singapore/" class="text-primary-600 hover:underline">view all ABRSM piano lessons</a>.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-white border-t border-primary-100">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-3">
          Build Your Child's ABRSM Piano Skills
        </h2>
        <p class="text-base-600 mb-6">Contact Patricia for a free consultation to discuss your child's current ability, ABRSM aspirations, and what structured preparation looks like.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/contact/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
            Book a Trial
          </a>
          <a
            href="https://wa.me/6583898853?text=Hi%20Ms%20Pat%2C%20I'd%20like%20to%20enquire%20about%20ABRSM%20piano%20lessons."
            target="_blank"
            rel="noopener noreferrer"
