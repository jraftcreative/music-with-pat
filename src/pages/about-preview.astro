---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
---

<BaseLayout
  title="About Patricia — Piano and Violin Teacher in Tengah | Music with Pat"
  description="Meet Patricia, a private piano and violin teacher in Tengah, Singapore with over 10 years of experience. Bachelor's degree in Early Childhood Education with Music Education."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <Header currentPage="/about/" />

  <main>
    <!-- ============================================================ -->
    <!-- MASTHEAD — WHITE — editorial title + offset-framed portrait  -->
    <!-- ============================================================ -->
    <section class="pt-10 md:pt-16 pb-10 md:pb-14 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto w-full">
        <div class="grid md:grid-cols-[1.15fr_0.85fr] gap-10 md:gap-14 items-end">
          <div>
            <p class="text-[11px] md:text-xs font-medium uppercase tracking-[0.24em] text-primary-700 mb-5">
              Piano &amp; Violin &middot; Tengah
            </p>
            <h1 class="text-base-900">
              <span class="block font-serif font-semibold text-6xl md:text-8xl leading-[0.92] tracking-tight">Patricia</span>
              <span class="block mt-4 md:mt-5 font-serif text-lg md:text-2xl text-base-600 leading-snug max-w-md">
                Private piano &amp; violin teacher in Tengah, Singapore
              </span>
            </h1>
          </div>

          <div class="relative w-full max-w-xs mx-auto md:mx-0 md:ml-auto">
            <div class="absolute -bottom-4 -right-4 w-full h-full rounded-2xl bg-primary-100" aria-hidden="true"></div>
            <img
              src="/patricia-piano-lessons.webp"
              width="1024"
              height="1280"
              alt="Patricia — piano and violin teacher in Tengah, Singapore"
              class="relative aspect-[4/5] object-cover object-top rounded-2xl w-full"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- STORY — WHITE — narrow column, drop cap, margin pull-quote   -->
    <!-- ============================================================ -->
    <section class="pb-14 md:pb-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto w-full">
        <div class="grid md:grid-cols-[1fr_0.55fr] gap-10 md:gap-16 items-start">
          <div class="max-w-[60ch]">
            <p class="text-base-700 text-base md:text-lg leading-relaxed mb-5 first-letter:float-left first-letter:mr-3 first-letter:mt-1 first-letter:font-serif first-letter:font-semibold first-letter:text-6xl md:first-letter:text-7xl first-letter:leading-[0.72] first-letter:text-primary-600">
              Patricia is a private piano and violin teacher based in Tengah, Singapore, with over 10 years of experience teaching students from age four through adulthood. She believes every student learns differently and grows at their own pace, and her approach is gentle, patient, and encouraging.
            </p>
            <p class="text-base-600 text-base md:text-lg leading-relaxed">
              With a Bachelor's degree in Early Childhood Education with Music Education, Patricia builds lessons that feel meaningful at every age &mdash; guiding students to develop confidence and cultivate their musical potential.
            </p>
          </div>

          <aside class="reveal md:pt-2 md:border-l md:border-primary-200 md:pl-8">
            <span class="block font-serif text-6xl text-primary-300 leading-[0.6] mb-1" aria-hidden="true">&ldquo;</span>
            <blockquote class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-snug tracking-tight">
              Every student learns differently, and grows at their own pace.
            </blockquote>
            <figcaption class="mt-3 font-sans text-sm tracking-wide text-base-500">&mdash; Patricia</figcaption>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- WHAT SETS HER APART — PINK — hairline-topped trio            -->
    <!-- ============================================================ -->
    <section class="py-14 md:py-20 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto w-full">
        <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-10">
          What sets her apart
        </p>
        <div class="grid md:grid-cols-3 gap-x-10 gap-y-10">
          <div class="reveal border-t border-primary-200 pt-5">
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-700 mb-3">Student-centred</p>
            <p class="text-sm md:text-base text-base-700 leading-relaxed">Every lesson is shaped to the student's pace, not a syllabus's.</p>
          </div>
          <div class="reveal border-t border-primary-200 pt-5">
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-700 mb-3">Early-childhood-trained</p>
            <p class="text-sm md:text-base text-base-700 leading-relaxed">A B.Ed in Early Childhood &amp; Music means lessons are built around how 4&ndash;7-year-olds actually learn &mdash; not adult piano scaled down.</p>
          </div>
          <div class="reveal border-t border-primary-200 pt-5">
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-700 mb-3">Home studio in Tengah</p>
            <p class="text-sm md:text-base text-base-700 leading-relaxed">A calm, home-based studio that puts students of all ages at ease.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CREDENTIAL — WHITE — editorial strip + framed second image  -->
    <!-- ============================================================ -->
    <section class="py-14 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto w-full">
        <div class="grid md:grid-cols-[1.4fr_1fr] gap-12 md:gap-16 items-center">
          <div class="reveal">
            <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-6">Credentials</p>
            <h2 class="font-serif font-semibold text-2xl md:text-4xl text-base-900 leading-[1.15] tracking-tight">
              Bachelor's Degree in Early Childhood Education with Music Education
            </h2>
            <hr class="w-24 border-t border-base-300 my-8" />
            <p class="text-[13px] font-medium uppercase tracking-[0.1em] text-base-700 mb-6">
              10+ years &nbsp;/&nbsp; Piano + Violin
            </p>
            <p class="text-base text-base-600 max-w-md leading-relaxed">
              Formal training in how young children learn, paired with music pedagogy &mdash; so every lesson is age-appropriate and developmentally sound.
            </p>
          </div>

          <div class="reveal relative">
            <div class="absolute -top-4 -left-4 w-full h-full rounded-2xl bg-primary-100 hidden md:block" aria-hidden="true"></div>
            <img
              src="/pat-piano-teacher-singapore.webp"
              width="900"
              height="1200"
              alt="Patricia teaching piano in her home studio in Tengah, Singapore"
              class="relative aspect-[3/4] object-cover object-top w-full rounded-2xl"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- THE TEACHING — PINK — hairline-ruled six-way list           -->
    <!-- ============================================================ -->
    <section class="py-14 md:py-20 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto w-full">
        <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-4">The teaching</p>
        <h2 class="font-serif font-semibold text-2xl md:text-4xl text-base-900 leading-[1.15] tracking-tight max-w-3xl mb-10 md:mb-12">
          Six ways Patricia meets a student where they are.
        </h2>

        <div class="grid md:grid-cols-2 gap-x-14">
          <div class="reveal border-t border-primary-200 py-6">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-2">Private piano lessons for children from age 4</h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">I start with the ear and the hands. Notation comes second, not first.</p>
          </div>
          <div class="reveal border-t border-primary-200 py-6">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-2">Private piano lessons for adults</h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">You're not starting late. You're starting now, with a teacher who treats that seriously.</p>
          </div>
          <div class="reveal border-t border-primary-200 py-6">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-2">ABRSM piano exam preparation (Grades 1&ndash;8)</h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">The grade is a checkpoint, not the point. I build the musician first.</p>
          </div>
          <div class="reveal border-t border-primary-200 py-6">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-2">ABRSM violin exam preparation (Grades 1&ndash;8)</h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">Tone before tricks. If it doesn't sound musical, the grade doesn't matter.</p>
          </div>
          <div class="reveal border-t border-primary-200 py-6">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-2">ABRSM music theory preparation</h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">Theory is how I explain what your ears already know. We work in that order.</p>
          </div>
          <div class="reveal border-t border-primary-200 py-6">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-2">DSA music audition preparation</h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">DSA panels can tell when a student has been drilled. I prepare them to play, not perform.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CLOSING — WHITE — editorial invitation (left-aligned)       -->
    <!-- ============================================================ -->
    <section class="py-16 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto w-full">
        <div class="max-w-[60ch]">
          <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-4">Come and play</p>
          <h2 class="reveal font-serif font-semibold text-3xl md:text-5xl text-base-900 leading-[1.1] tracking-tight">
            Ready to meet Patricia?
          </h2>
          <p class="reveal mt-5 text-base md:text-lg text-base-600 max-w-xl leading-relaxed">
            Book a trial lesson to talk through your child's start &mdash; or your own &mdash; and find the right fit. No pressure, just a friendly first conversation.
          </p>
          <div class="reveal mt-8 flex flex-col sm:flex-row gap-3">
            <a
              href="/contact/"
              class="inline-flex items-center justify-center bg-primary-600 hover:bg-primary-700 text-white font-medium text-base px-8 py-3 rounded-lg transition-colors"
            >
              Book a trial
            </a>
            <a
              href="https://wa.me/6583898853"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 border border-base-200 hover:border-primary-400 text-base-700 hover:text-primary-600 font-medium text-base px-8 py-3 rounded-lg transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp Patricia
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <BottomNav />
  <WhatsAppButton />

  <script is:inline>
    (function () {
      var nodes = document.querySelectorAll('.reveal');
      if (!nodes.length) return;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduce) {
        nodes.forEach(function (n) { n.classList.add('is-visible'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3, rootMargin: '0px 0px -10% 0px' });
      nodes.forEach(function (n) { io.observe(n); });
    })();
  </script>
</BaseLayout>
