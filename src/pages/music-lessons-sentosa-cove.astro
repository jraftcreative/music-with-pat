---
// Music Lessons in Sentosa Cove — location landing page (full-bleed hero layout).
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'

const waHref = "https://wa.me/6583898853?text=Hi%20Ms%20Pat%2C%20I'd%20like%20to%20enquire%20about%20music%20lessons%20in%20Sentosa%20Cove."

// Real reviews — from Patricia's main testimonials page (/testimonials/).
// NOTE: 4 real reviews on file. Add more (e.g. from Google) to enrich the conveyor.
const reviews = [
  {
    stars: 5,
    text: "We've had a great experience with teacher Patricia. She is patient, kind, and knows how to keep kids engaged and motivated during lessons. We've seen clear improvement in their playing skills and their discipline.",
    name: "Gene",
    relation: "Mother of Adam and Renee"
  },
  {
    stars: 5,
    text: "Pat has such a gentle way with children. My daughter looks forward to her lessons every week! She's made incredible progress in just 6 months.",
    name: "Sarah L.",
    relation: "Mother of Emily, Age 7"
  },
  {
    stars: 5,
    text: "We tried other teachers before, but Pat's nurturing approach finally got my son excited about piano. He now practices without being asked!",
    name: "Michelle T.",
    relation: "Mother of Ryan, Age 9"
  },
  {
    stars: 5,
    text: "Pat prepared my daughter for her ABRSM Grade 3 exam and she passed with distinction! Highly recommend for anyone looking for quality piano lessons.",
    name: "Jennifer C.",
    relation: "Mother of Sophie, Age 11"
  }
]

const faqs = [
  {
    question: "What instruments can I learn with Patricia near Sentosa Cove?",
    answer: "Patricia teaches piano and violin, weaving in music theory, ear training, and rhythm at every lesson. Children and adults can start with one instrument or try both. All sessions are private and one-to-one, so the lesson is tailored entirely to the student."
  },
  {
    question: "How long does it take to reach Patricia's studio from Sentosa Cove?",
    answer: "The drive from Sentosa Cove to Patricia's Tengah studio takes approximately 25 minutes in normal traffic — exit via the Sentosa Gateway and join the AYE heading west. On public transport, take the MRT from HarbourFront to Buona Vista on the Circle Line, transfer to the East-West Line towards Jurong East, then connect to Tengah. Many families schedule lessons during off-peak hours or on weekends to keep the journey relaxed."
  },
  {
    question: "Can Patricia come to our home in Sentosa Cove for lessons?",
    answer: "Patricia teaches primarily from her Tengah home studio, which provides a quiet, dedicated learning environment. House visits to Sentosa Cove may be available on a case-by-case basis depending on her schedule — reach out to Patricia on WhatsApp to discuss your family's needs and time-slot availability."
  },
  {
    question: "Do you teach adult beginners near Sentosa Cove?",
    answer: "Yes. Patricia welcomes adult learners from Sentosa Cove, whether you are a complete beginner or returning to an instrument after a break. Adults can learn piano or violin at their own pace, working towards ABRSM grades or simply playing for enjoyment, at the Tengah studio or via home visits."
  },
  {
    question: "How do I know if my child is ready for music lessons?",
    answer: "Patricia teaches children from age four. At this stage, most children can follow simple instructions, sit for a structured activity, and begin developing the hand coordination needed for an instrument. Patricia always begins with a no-obligation consultation to assess readiness and discuss expectations with parents."
  }
]

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
}
---

<BaseLayout
  title="Music Lessons in Sentosa Cove | Piano & Violin | Music with Pat"
  description="Piano & violin lessons in Sentosa Cove, Singapore for children and adults — studio or home visits. Book a trial with Patricia."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Music Lessons",
      "name": "Music Lessons in Sentosa Cove",
      "provider": { "@type": "LocalBusiness", "@id": "https://www.musicwithpat.com/#business", "name": "Music with Pat" },
      "areaServed": { "@type": "Place", "name": "Sentosa Cove, Singapore" },
      "audience": { "@type": "PeopleAudience", "suggestedMinAge": 4 },
      "description": "Music lessons in Sentosa Cove, Singapore for children and adults. Piano, violin, and general musicianship with ABRSM exam preparation, at Patricia's Tengah studio or via home visits."
    }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
  </Fragment>

  <Header />

  <main>
    <!-- 1 · HERO (EXPERIMENT: full-bleed image + warm scrim, text overlaid) -->
    <section class="relative overflow-hidden md:min-h-[calc(100vh-6rem)] flex items-center px-6 md:px-12 py-20 md:py-6">
      <!-- full-bleed background photo (gentle zoom). background-size = zoom level; background-position X = where Patricia sits (smaller X pushes her further right). -->
      <div class="hero-bg absolute inset-0" role="img" aria-label="Patricia teaching piano — music lessons in Sentosa Cove, Singapore"></div>
      <!-- warm scrim for text legibility (on-brand, not harsh black) -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#2d1a0e]/62 via-[#2d1a0e]/36 to-[#2d1a0e]/10"></div>

      <!-- overlaid copy -->
      <div class="hero-copy relative z-10 w-full max-w-6xl mx-auto">
        <div class="max-w-2xl text-center md:text-left mx-auto md:mx-0">
          <p class="text-primary-200 font-medium mb-3">Sentosa Cove, Singapore</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-semibold text-white mb-5 leading-tight">
            Music Lessons in Sentosa Cove
          </h1>
          <p class="text-white/90 text-lg md:text-xl mb-8 max-w-xl mx-auto md:mx-0">
            Patient, one-to-one piano and violin lessons that build real skill — and a genuine love of music. For children and adults, taught at a pace that's right for you.
          </p>

          <div class="flex flex-col sm:flex-row justify-center md:justify-start gap-3 mb-6">
            <a href="/contact/" class="inline-block px-8 py-4 bg-primary-600 text-white font-medium rounded-full hover:bg-primary-700 transition-colors">
              Book a Trial
            </a>
            <a href={waHref} target="_blank" rel="noopener noreferrer"
              class="px-8 py-4 bg-whatsapp text-white font-medium rounded-full hover:bg-whatsapp-dark transition-colors flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp Pat
            </a>
          </div>

          <div class="flex flex-wrap justify-center md:justify-start items-center gap-x-5 gap-y-2 text-sm text-white/85">
            <span class="inline-flex items-center gap-1"><span class="text-primary-300">★★★★★</span> Loved by Sentosa Cove families</span>
            <span class="text-white/40">•</span>
            <span>10+ years teaching</span>
            <span class="text-white/40">•</span>
            <span>ABRSM exam prep</span>
            <span class="text-white/40">•</span>
            <span>Home visits available</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · THE PARENT'S QUESTION (new hook) -->
    <section class="py-12 md:py-20 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-primary-600 font-medium mb-2">Why Music with Pat</p>
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">
          Finding the right music teacher shouldn't be stressful
        </h2>
        <p class="text-base-600 md:text-lg">
          Most Sentosa Cove families aren't looking for a big commercial school with rotating teachers and crowded waiting rooms. They want one dependable teacher who genuinely knows their child — or who can make an adult beginner feel at ease. That's exactly how Patricia teaches: patiently, one-to-one, and at a pace that fits the student, not a timetable.
        </p>
      </div>
    </section>

    <!-- 3 · MEET PATRICIA -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2">
            <img src="/patricia-piano-lessons.webp" width="1024" height="1280"
              alt="Patricia — piano and violin teacher serving Sentosa Cove"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full" loading="lazy" />
          </div>
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2">Meet the Teacher</p>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900 mb-4">About Patricia</h2>
            <p class="text-base-600 mb-4">
              Patricia has been teaching music for over ten years, and works regularly with families and adult learners across the Sentosa Cove area — from first-time beginners to students preparing for their ABRSM exams.
            </p>
            <p class="text-base-600 mb-4">
              Her background is unusual and valuable: a Bachelor's in Early Childhood Education with Music Education gives her both musical depth and a real understanding of how people learn. She reads where each student is and adjusts accordingly.
            </p>
            <p class="text-base-600 mb-6">
              She teaches piano and violin, with ABRSM exam preparation available for both — and is equally committed to students who simply want to play for the love of it.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">B.Ed Early Childhood &amp; Music</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">10+ Years Experience</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">ABRSM Preparation</span>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">Piano &amp; Violin</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · WHY CHOOSE (reshaped to 3 cards) -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Why Families Trust Patricia</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">Three reasons Sentosa Cove families choose Patricia</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-2">Two instruments, one teacher</h3>
            <p class="text-base-600 text-sm">Piano and violin, with ear training, rhythm, and theory built into every lesson — a complete musical foundation, not just notes on a page.</p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-2">Trained in how people learn</h3>
            <p class="text-base-600 text-sm">A B.Ed in Early Childhood &amp; Music Education means young children are never pushed too fast, and adult beginners are never made to feel behind.</p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-2">Exam or just for joy</h3>
            <p class="text-base-600 text-sm">Full ABRSM exam preparation when you want it — or a relaxed, enjoyment-first path when you don't. Patricia adapts to the student's goals.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · REVIEWS (auto-scrolling conveyor belt) -->
    <section class="py-12 md:py-24 bg-white overflow-hidden">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        <div class="text-center mb-10">
          <p class="text-primary-600 font-medium mb-2">What Families Say</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">Loved by parents like you</h2>
        </div>
      </div>
      <div class="marquee">
        <div class="marquee__track">
          <ul class="marquee__group">
            {reviews.map(r => (
              <li class="marquee__card bg-primary-50 rounded-2xl p-6 border border-primary-100 flex flex-col">
                <div class="text-primary-500 mb-3" aria-label={`${r.stars} out of 5 stars`}>★★★★★</div>
                <blockquote class="text-base-600 text-sm mb-4 flex-1">“{r.text}”</blockquote>
                <figcaption class="text-sm font-semibold text-base-900">{r.name}<span class="font-normal text-base-600">, {r.relation}</span></figcaption>
              </li>
            ))}
          </ul>
          <ul class="marquee__group" aria-hidden="true">
            {reviews.map(r => (
              <li class="marquee__card bg-primary-50 rounded-2xl p-6 border border-primary-100 flex flex-col">
                <div class="text-primary-500 mb-3">★★★★★</div>
                <blockquote class="text-base-600 text-sm mb-4 flex-1">“{r.text}”</blockquote>
                <figcaption class="text-sm font-semibold text-base-900">{r.name}<span class="font-normal text-base-600">, {r.relation}</span></figcaption>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 6 · MID-PAGE CTA (new; sticky WhatsApp = floating component below) -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-primary-600">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-white mb-3">Ready to try a lesson?</h2>
        <p class="text-primary-50 mb-6">The easiest first step is a no-obligation trial lesson. Message Patricia and she'll find a time that suits you.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href={waHref} target="_blank" rel="noopener noreferrer"
            class="px-8 py-4 bg-whatsapp text-white font-medium rounded-full hover:bg-whatsapp-dark transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Pat
          </a>
          <a href="/contact/" class="inline-block px-8 py-4 bg-white text-primary-700 font-medium rounded-full hover:bg-primary-50 transition-colors">
            Book a Trial
          </a>
        </div>
      </div>
    </section>

    <!-- 7 · WHAT LESSONS LOOK LIKE -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Lesson Structure</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">What lessons look like</h2>
        </div>
        <div class="space-y-4 text-base-600">
          <p>Lessons are private and one-to-one, running 45 to 60 minutes depending on the student's age and stage. Younger beginners start with shorter, focused sessions that lengthen as stamina and confidence grow.</p>
          <p>Each session balances instrument work on piano or violin with musicianship — theory, sight-reading, and ear training — sequenced so students stay engaged without losing the thread. Progress is steady and visible to both student and parent.</p>
          <p>The experience is consistent whether you visit the Tengah studio or Patricia travels to your Sentosa Cove home. Either way, you get the same attentive, tailored instruction.</p>
        </div>
      </div>
    </section>

    <!-- 8 · GETTING HERE + HOME VISITS -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Easy to Reach</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">Getting here from Sentosa Cove</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div class="space-y-4 text-base-600">
            <p>Sentosa Cove is about 25 minutes from Patricia's Tengah studio by car — exit via the Sentosa Gateway and join the AYE heading west. The route runs through the southern expressway corridor and is straightforward to navigate; many families schedule lessons during off-peak hours or on weekends to keep the journey relaxed.</p>
            <p>On public transport, take the MRT from HarbourFront to Buona Vista on the Circle Line, transfer to the East-West Line towards Jurong East, then connect to Tengah.</p>
            <p>Prefer lessons at home? Patricia offers house visits to Sentosa Cove on a case-by-case basis depending on her schedule — a popular choice for younger children, who often focus best in their own space.</p>
          </div>
          <div class="bg-white rounded-xl p-6 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-4">Transport options</h3>
            <ul class="space-y-3 text-sm text-base-600">
              <li><strong class="text-base-900">By car:</strong> ~25 minutes via Sentosa Gateway to the AYE westbound</li>
              <li><strong class="text-base-900">By MRT:</strong> HarbourFront to Buona Vista (Circle Line), transfer to the East-West Line towards Jurong East, then connect to Tengah</li>
              <li><strong class="text-base-900">House visits:</strong> May be available to Sentosa Cove depending on schedule — contact Patricia to discuss</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 9 · ADULT LEARNERS -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Not Just for Children</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">Adult beginners are welcome too</h2>
        </div>
        <div class="space-y-4 text-base-600">
          <p>Plenty of adults in the Sentosa Cove area pick up an instrument for the first time — or return to one they set aside years ago. Patricia teaches <a href="/adult-piano-lessons/" class="text-primary-600 hover:underline">adult piano</a> and <a href="/adult-violin-lessons/" class="text-primary-600 hover:underline">adult violin</a> learners with the same patience she brings to her younger students, at a pace that fits around work and family.</p>
          <p>There's no such thing as being too old to start. Adults often progress quickly because they bring focus and clear goals — whether that's playing for relaxation, working towards an ABRSM grade, or finally learning a piece they've always loved.</p>
        </div>
      </div>
    </section>

    <!-- 10 · FAQ -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-primary-50">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Common Questions</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">Frequently asked questions</h2>
        </div>
        <div class="space-y-3">
          {faqs.map(faq => (
            <details class="group bg-white rounded-xl">
              <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
                <span class="font-medium text-base-900 text-sm md:text-base pr-4">{faq.question}</span>
                <span class="text-primary-600 group-open:rotate-45 transition-transform text-xl flex-shrink-0">+</span>
              </summary>
              <div class="px-4 pb-4 text-base-600 text-sm">{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 11 · EXPLORE MORE (combined instrument + nearby-area links) -->
    <section class="py-12 md:py-20 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <p class="text-primary-600 font-medium mb-2">Explore More</p>
          <h2 class="text-2xl md:text-3xl font-serif font-semibold text-base-900">More ways to learn with Patricia</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">

          <!-- other lessons in Sentosa Cove -->
          <div class="bg-primary-50 rounded-2xl p-6 md:p-8 border border-primary-100">
            <h3 class="text-lg font-semibold text-base-900 mb-1">Focus on one instrument</h3>
            <p class="text-base-600 text-sm mb-5">Prefer a single instrument in Sentosa Cove? Explore the dedicated pages.</p>
            <div class="flex flex-wrap gap-2">
