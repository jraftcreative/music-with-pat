---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
---

<BaseLayout
  title="About Patricia — Piano and Violin Teacher in Tengah | Music with Pat"
  description="Meet Patricia, a private piano and violin teacher in Tengah, Singapore with over 10 years of experience. Bachelor's degree in Early Childhood Education with Music Education."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Patricia",
      "jobTitle": "Private Piano and Violin Teacher",
      "description": "Private piano and violin teacher based in Tengah, Singapore. Specialises in lessons for children from age four, with ABRSM preparation across piano, violin, and music theory.",
      "hasCredential": [{
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "educationalLevel": "Bachelor",
        "name": "Bachelor's Degree in Early Childhood Education with Music Education"
      }],
      "knowsAbout": ["Piano Pedagogy", "Violin Pedagogy", "ABRSM Examinations", "Music Theory", "Early Childhood Music Education", "DSA Music Audition Preparation"],
      "areaServed": [
        {"@type": "Place", "name": "Tengah"},
        {"@type": "Place", "name": "Bukit Batok"},
        {"@type": "Place", "name": "Jurong East"},
        {"@type": "Place", "name": "Choa Chu Kang"},
        {"@type": "Place", "name": "Bukit Timah"}
      ],
      "worksFor": {
        "@type": "MusicSchool",
        "name": "Music with Pat",
        "url": "https://www.musicwithpat.com"
      },
      "url": "https://www.musicwithpat.com/about/"
    }
    </script>
  </Fragment>

  <Header currentPage="/about/" />
  <Breadcrumbs items={[{ label: 'About Patricia' }]} />

  <main>
    <!-- Hero — UNCHANGED per Mei's spec -->
    <section class="py-12 md:py-24 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="md:order-2">
            <img
              src="/patricia-piano-lessons.webp"
              width="1024"
              height="1280"
              alt="Patricia - Piano and Violin Teacher for Children in Singapore"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full"
            />
          </div>
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2">Meet Your Teacher</p>
            <h1 class="text-2xl md:text-3xl lg:text-4xl font-serif font-semibold text-base-900 mb-4">
              About Patricia — Piano and Violin Teacher in Tengah, Singapore
            </h1>
            <p class="text-base-600 text-lg md:text-xl mb-4">
              Patricia is a private piano and violin teacher based in Tengah, Singapore with over 10 years of experience teaching young children from age four and up. She believes that every child learns differently and grows at their own pace, and her teaching approach is gentle, patient, and encouraging.
            </p>
            <p class="text-base-600 mb-4">
              With a Bachelor's degree in Early Childhood Education with Music Education, Patricia thoughtfully designs lessons that feel safe, enjoyable, and meaningful for young learners. Through fun and creative activities, children are guided to build confidence, develop musical understanding, and gradually cultivate their musical potential.
            </p>
            <p class="text-base-600 mb-6">
              She offers ABRSM syllabus preparation across piano, violin, and music theory where appropriate, and lessons take place in a calm, home-based studio in Tengah, Singapore where children feel comfortable, supported, and free to grow.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- A — "What Sets Patricia Apart" → editorial pull-quote        -->
    <!-- bg-warm-50, oversized Playfair italic, marginalia underneath -->
    <!-- ============================================================ -->
    <section class="py-20 md:py-28 px-6 md:px-12 bg-warm-50">
      <div class="max-w-5xl mx-auto">
        <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-warm-600 mb-10">
          01 &mdash; How she teaches
        </p>

        <figure class="reveal max-w-3xl">
          <blockquote class="font-serif italic text-4xl md:text-6xl text-base-900 leading-[1.1]">
            &ldquo;Every child learns differently, and grows at their own pace.&rdquo;
          </blockquote>
          <figcaption class="mt-6 font-sans text-sm tracking-wide text-base-600">
            &mdash; Patricia
          </figcaption>
        </figure>

        <hr class="border-t border-warm-300 mt-16 mb-10" />

        <div class="grid md:grid-cols-3 gap-x-10 gap-y-10">
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-600 mb-3">
              Child-centred
            </p>
            <p class="text-sm text-base-700 leading-relaxed max-w-xs">
              Every lesson is shaped to your child's pace, not a syllabus's.
            </p>
          </div>
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-600 mb-3">
              Early-childhood-trained
            </p>
            <p class="text-sm text-base-700 leading-relaxed max-w-xs">
              A B.Ed in Early Childhood &amp; Music means lessons are built around how 4&ndash;7-year-olds actually learn &mdash; not adult piano scaled down.
            </p>
          </div>
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-600 mb-3">
              Home studio in Tengah
            </p>
            <p class="text-sm text-base-700 leading-relaxed max-w-xs">
              A calm, home-based studio that 4-year-olds settle into fast.
            </p>
          </div>
        </div>

        <!-- Visually hidden H2 for SEO + a11y — heading hierarchy preserved -->
        <h2 class="sr-only">What sets Patricia apart</h2>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- B — Credentials & Training → single authority statement      -->
    <!-- Asymmetric two-column: typographic left, tall portrait right -->
    <!-- ============================================================ -->
    <section class="py-16 md:py-24 px-6 md:px-12 bg-white border-t border-b border-base-200">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-[1.4fr_1fr] gap-12 md:gap-16 items-start">
          <div class="reveal">
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-600 mb-6">
              Credentials
            </p>
            <h2 class="font-serif text-3xl md:text-5xl text-base-900 leading-[1.05] tracking-tight">
              Bachelor's Degree in Early Childhood Education with Music Education
            </h2>

            <hr class="w-24 border-t border-base-300 my-8" />

            <p class="text-[13px] font-medium uppercase tracking-[0.1em] text-warm-600 mb-6">
              10+ years &nbsp;/&nbsp; Piano + Violin
            </p>

            <p class="text-base text-base-600 max-w-md leading-relaxed">
              Formal training in how young children learn, paired with music pedagogy &mdash; so every lesson is age-appropriate and developmentally sound.
            </p>
          </div>

          <!-- Photo: desktop only -->
          <div class="hidden md:block photo-zoom">
            <img
              src="/pat-piano-teacher-singapore.webp"
              width="900"
              height="1200"
              alt="Patricia teaching piano in her home studio in Tengah, Singapore"
              class="aspect-[3/4] object-cover object-top w-full"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- C — "What Patricia Teaches" → editorial numbered list 01-06  -->
    <!-- bg-primary-50, ordered list, hairlines between rows          -->
    <!-- Sophie's 6 philosophy lines verbatim, staggered reveal       -->
    <!-- ============================================================ -->
    <section class="py-24 md:py-32 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto">
        <p class="text-[11px] md:text-xs font-medium uppercase tracking-[0.18em] text-primary-700 mb-6">
          The teaching
        </p>
        <h2 class="font-serif text-4xl md:text-6xl text-base-900 leading-[1.05] tracking-tight max-w-2xl mb-16 md:mb-20">
          Six ways Patricia meets a child where they are.
        </h2>

        <ol class="border-t border-primary-200">
          <li class="reveal grid grid-cols-[40px_1fr] md:grid-cols-[60px_1fr_1fr] gap-x-6 md:gap-x-12 py-6 md:py-8 border-b border-primary-100" style="transition-delay: 0ms;">
            <span class="font-serif text-2xl text-primary-400 tabular-nums leading-none pt-1">01</span>
            <h3 class="font-serif text-2xl md:text-4xl text-base-900 leading-tight">
              Private piano lessons for children from age 4
            </h3>
            <p class="col-start-2 md:col-start-3 mt-3 md:mt-0 font-sans italic text-sm text-base-600 leading-relaxed max-w-xs">
              I start with the ear and the hands. Notation comes second, not first.
            </p>
          </li>

          <li class="reveal grid grid-cols-[40px_1fr] md:grid-cols-[60px_1fr_1fr] gap-x-6 md:gap-x-12 py-6 md:py-8 border-b border-primary-100" style="transition-delay: 80ms;">
            <span class="font-serif text-2xl text-primary-400 tabular-nums leading-none pt-1">02</span>
            <h3 class="font-serif text-2xl md:text-4xl text-base-900 leading-tight">
              Private piano lessons for adults
            </h3>
            <p class="col-start-2 md:col-start-3 mt-3 md:mt-0 font-sans italic text-sm text-base-600 leading-relaxed max-w-xs">
              You're not starting late. You're starting now, with a teacher who treats that seriously.
            </p>
          </li>

          <li class="reveal grid grid-cols-[40px_1fr] md:grid-cols-[60px_1fr_1fr] gap-x-6 md:gap-x-12 py-6 md:py-8 border-b border-primary-100" style="transition-delay: 160ms;">
            <span class="font-serif text-2xl text-primary-400 tabular-nums leading-none pt-1">03</span>
            <h3 class="font-serif text-2xl md:text-4xl text-base-900 leading-tight">
              ABRSM piano exam preparation (Grades 1&ndash;5)
            </h3>
            <p class="col-start-2 md:col-start-3 mt-3 md:mt-0 font-sans italic text-sm text-base-600 leading-relaxed max-w-xs">
              The grade is a checkpoint, not the point. I build the musician first.
            </p>
          </li>

          <li class="reveal grid grid-cols-[40px_1fr] md:grid-cols-[60px_1fr_1fr] gap-x-6 md:gap-x-12 py-6 md:py-8 border-b border-primary-100" style="transition-delay: 240ms;">
            <span class="font-serif text-2xl text-primary-400 tabular-nums leading-none pt-1">04</span>
            <h3 class="font-serif text-2xl md:text-4xl text-base-900 leading-tight">
              ABRSM violin exam preparation (Grades 1&ndash;5)
            </h3>
            <p class="col-start-2 md:col-start-3 mt-3 md:mt-0 font-sans italic text-sm text-base-600 leading-relaxed max-w-xs">
              Tone before tricks. If it doesn't sound musical, the grade doesn't matter.
            </p>
          </li>

          <li class="reveal grid grid-cols-[40px_1fr] md:grid-cols-[60px_1fr_1fr] gap-x-6 md:gap-x-12 py-6 md:py-8 border-b border-primary-100" style="transition-delay: 320ms;">
            <span class="font-serif text-2xl text-primary-400 tabular-nums leading-none pt-1">05</span>
            <h3 class="font-serif text-2xl md:text-4xl text-base-900 leading-tight">
              ABRSM music theory preparation
            </h3>
            <p class="col-start-2 md:col-start-3 mt-3 md:mt-0 font-sans italic text-sm text-base-600 leading-relaxed max-w-xs">
              Theory is how I explain what your ears already know. We work in that order.
            </p>
          </li>

          <li class="reveal grid grid-cols-[40px_1fr] md:grid-cols-[60px_1fr_1fr] gap-x-6 md:gap-x-12 py-6 md:py-8" style="transition-delay: 400ms;">
            <span class="font-serif text-2xl text-primary-400 tabular-nums leading-none pt-1">06</span>
            <h3 class="font-serif text-2xl md:text-4xl text-base-900 leading-tight">
              DSA music audition preparation
            </h3>
            <p class="col-start-2 md:col-start-3 mt-3 md:mt-0 font-sans italic text-sm text-base-600 leading-relaxed max-w-xs">
              DSA panels can tell when a child has been drilled. I prepare them to play, not perform.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- D — Bottom CTA → editorial closing, text-link not button     -->
    <!-- ============================================================ -->
    <section class="py-24 md:py-32 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="sr-only">Book a free trial lesson</h2>
        <p class="reveal font-serif italic text-3xl md:text-5xl text-base-900 leading-[1.1]">
          If this sounds like the kind of teacher you want for your child &mdash;
        </p>
        <hr class="w-10 border-t border-primary-300 mx-auto my-10" />
        <a href="/contact/" class="link-arrow font-sans text-lg text-primary-600">
          <span>book a free trial lesson</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <BottomNav />
  <WhatsAppButton />

  <!-- Scroll-reveal: lightweight IntersectionObserver. -->
  <!-- All visible copy is already in the server-rendered HTML above. -->
  <!-- This script only toggles a class for opacity/transform animation. -->
  <!-- If JS is disabled or fails, content remains accessible via the   -->
  <!-- prefers-reduced-motion fallback in global.css (opacity: 1).      -->
  <script is:inline>
    (function () {
      var nodes = document.querySelectorAll('.reveal');
      if (!nodes.length) return;

      // No IntersectionObserver support OR reduced motion → just show everything.
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduce) {
        nodes.forEach(function (n) { n.classList.add('is-visible'); });
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3, rootMargin: '0px 0px -10% 0px' });

      nodes.forEach(function (n) { io.observe(n); });
    })();
  </script>
</BaseLayout>
