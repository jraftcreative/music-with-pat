---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import BottomNav from '../components/BottomNav.astro'
import WhatsAppButton from '../components/WhatsAppButton.astro'
---

<BaseLayout
  title="About Patricia — Piano and Violin Teacher in Tengah | Music with Pat"
  description="Meet Patricia, a private piano and violin teacher in Tengah, Singapore with over 10 years of experience. Bachelor's degree in Early Childhood Education with Music Education."
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Patricia",
      "jobTitle": "Private Piano and Violin Teacher",
      "description": "Private piano and violin teacher based in Tengah, Singapore. Specialises in lessons for children from age four, with ABRSM preparation across piano, violin, and music theory.",
      "hasCredential": [{
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "educationalLevel": "Bachelor",
        "name": "Bachelor's Degree in Early Childhood Education with Music Education"
      }],
      "knowsAbout": ["Piano Pedagogy", "Violin Pedagogy", "ABRSM Examinations", "Music Theory", "Early Childhood Music Education", "DSA Music Audition Preparation"],
      "areaServed": [
        {"@type": "Place", "name": "Tengah"},
        {"@type": "Place", "name": "Bukit Batok"},
        {"@type": "Place", "name": "Jurong East"},
        {"@type": "Place", "name": "Choa Chu Kang"},
        {"@type": "Place", "name": "Bukit Timah"}
      ],
      "worksFor": {
        "@type": "MusicSchool",
        "name": "Music with Pat",
        "url": "https://www.musicwithpat.com"
      },
      "url": "https://www.musicwithpat.com/about/"
    }
    </script>
  </Fragment>

  <Header currentPage="/about/" />
  <Breadcrumbs items={[{ label: 'About Patricia' }]} />

  <main>
    <!-- ============================================================ -->
    <!-- HERO — WHITE — content top-aligned, no wasted whitespace     -->
    <!-- ============================================================ -->
    <section class="py-6 md:py-10 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto w-full">
        <div class="grid md:grid-cols-[1.1fr_1fr] gap-8 md:gap-12 items-center">
          <div class="md:order-1">
            <p class="text-primary-600 font-medium mb-2 text-xs md:text-sm uppercase tracking-wider">Meet Your Teacher</p>
            <h1 class="font-serif font-semibold text-2xl md:text-3xl lg:text-4xl text-base-900 leading-[1.15] mb-4">
              About Patricia — Piano and Violin Teacher in Tengah, Singapore
            </h1>
            <p class="text-base-600 text-sm md:text-base leading-relaxed mb-3">
              Patricia is a private piano and violin teacher based in Tengah, Singapore, with over 10 years of experience teaching students from age four through adulthood. She believes every student learns differently and grows at their own pace, and her approach is gentle, patient, and encouraging.
            </p>
            <p class="text-base-600 text-sm md:text-base leading-relaxed">
              With a Bachelor's degree in Early Childhood Education with Music Education, Patricia builds lessons that feel meaningful at every age — guiding students to develop confidence and cultivate their musical potential.
            </p>
          </div>
          <div class="md:order-2">
            <img
              src="/patricia-piano-lessons.webp"
              width="1024"
              height="1280"
              alt="Patricia - Piano and Violin Teacher in Singapore"
              class="aspect-[4/5] object-cover object-top rounded-2xl w-full max-h-[50vh] md:max-h-[65vh] mx-auto"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- A — Pull-quote — PINK                                        -->
    <!-- ============================================================ -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto w-full">
        <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-6">
          How she teaches
        </p>

        <figure class="reveal max-w-3xl">
          <blockquote class="font-serif font-semibold text-2xl md:text-4xl text-base-900 leading-[1.15] tracking-tight">
            &ldquo;Every student learns differently, and grows at their own pace.&rdquo;
          </blockquote>
          <figcaption class="mt-4 font-sans text-sm tracking-wide text-base-600">
            &mdash; Patricia
          </figcaption>
        </figure>

        <hr class="border-t border-primary-200 mt-10 mb-8" />

        <div class="grid md:grid-cols-3 gap-x-10 gap-y-10">
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-700 mb-3">
              Student-centred
            </p>
            <p class="text-sm text-base-700 leading-relaxed max-w-xs">
              Every lesson is shaped to the student's pace, not a syllabus's.
            </p>
          </div>
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-700 mb-3">
              Early-childhood-trained
            </p>
            <p class="text-sm text-base-700 leading-relaxed max-w-xs">
              A B.Ed in Early Childhood &amp; Music means lessons are built around how 4&ndash;7-year-olds actually learn &mdash; not adult piano scaled down.
            </p>
          </div>
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.18em] text-primary-700 mb-3">
              Home studio in Tengah
            </p>
            <p class="text-sm text-base-700 leading-relaxed max-w-xs">
              A calm, home-based studio that puts students of all ages at ease.
            </p>
          </div>
        </div>

        <h2 class="sr-only">What sets Patricia apart</h2>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- B — Credentials — WHITE — single authority statement         -->
    <!-- ============================================================ -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-white">
      <div class="max-w-5xl mx-auto w-full">
        <div class="grid md:grid-cols-[1.4fr_1fr] gap-12 md:gap-16 items-center">
          <div class="reveal">
            <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-6">
              Credentials
            </p>
            <h2 class="font-serif font-semibold text-2xl md:text-4xl text-base-900 leading-[1.15] tracking-tight">
              Bachelor's Degree in Early Childhood Education with Music Education
            </h2>

            <hr class="w-24 border-t border-base-300 my-8" />

            <p class="text-[13px] font-medium uppercase tracking-[0.1em] text-base-700 mb-6">
              10+ years &nbsp;/&nbsp; Piano + Violin
            </p>

            <p class="text-base text-base-600 max-w-md leading-relaxed">
              Formal training in how young children learn, paired with music pedagogy &mdash; so every lesson is age-appropriate and developmentally sound.
            </p>
          </div>

          <div class="hidden md:block">
            <img
              src="/pat-piano-teacher-singapore.webp"
              width="900"
              height="1200"
              alt="Patricia teaching piano in her home studio in Tengah, Singapore"
              class="aspect-[3/4] object-cover object-top w-full"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- C — Six ways — PINK — 2-col grid, NO numbers                 -->
    <!-- ============================================================ -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-primary-50">
      <div class="max-w-5xl mx-auto w-full">
        <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-6">
          The teaching
        </p>
        <h2 class="font-serif font-semibold text-2xl md:text-4xl text-base-900 leading-[1.15] tracking-tight max-w-3xl mb-10 md:mb-12">
          Six ways Patricia meets a student where they are.
        </h2>

        <div class="grid md:grid-cols-2 gap-x-12 gap-y-10 md:gap-y-12">
          <div class="reveal">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-3">
              Private piano lessons for children from age 4
            </h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">
              I start with the ear and the hands. Notation comes second, not first.
            </p>
          </div>

          <div class="reveal">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-3">
              Private piano lessons for adults
            </h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">
              You're not starting late. You're starting now, with a teacher who treats that seriously.
            </p>
          </div>

          <div class="reveal">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-3">
              ABRSM piano exam preparation (Grades 1&ndash;8)
            </h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">
              The grade is a checkpoint, not the point. I build the musician first.
            </p>
          </div>

          <div class="reveal">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-3">
              ABRSM violin exam preparation (Grades 1&ndash;8)
            </h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">
              Tone before tricks. If it doesn't sound musical, the grade doesn't matter.
            </p>
          </div>

          <div class="reveal">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-3">
              ABRSM music theory preparation
            </h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">
              Theory is how I explain what your ears already know. We work in that order.
            </p>
          </div>

          <div class="reveal">
            <h3 class="font-serif font-semibold text-xl md:text-2xl text-base-900 leading-tight mb-3">
              DSA music audition preparation
            </h3>
            <p class="text-sm md:text-base text-base-600 leading-relaxed">
              DSA panels can tell when a student has been drilled. I prepare them to play, not perform.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- D — CTA — WHITE — "Book a trial" button                      -->
    <!-- ============================================================ -->
    <section class="py-12 md:py-16 px-6 md:px-12 bg-white">
      <div class="max-w-3xl mx-auto w-full text-center">
        <h2 class="reveal font-serif font-semibold text-2xl md:text-4xl text-base-900 leading-[1.15] tracking-tight">
          Ready to meet Patricia?
        </h2>
        <p class="reveal mt-4 text-base text-base-600 max-w-xl mx-auto">
          Book a trial lesson to discuss your musical goals.
        </p>
        <a
          href="/contact/"
          class="reveal inline-block mt-8 bg-primary-600 hover:bg-primary-700 text-white font-medium text-base px-8 py-3 rounded-lg transition-colors"
        >
          Book a trial
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <BottomNav />
  <WhatsAppButton />

  <!-- Scroll-reveal: lightweight IntersectionObserver. -->
  <!-- All visible copy is in the server-rendered HTML above. -->
  <script is:inline>
    (function () {
      var nodes = document.querySelectorAll('.reveal');
      if (!nodes.length) return;

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduce) {
        nodes.forEach(function (n) { n.classList.add('is-visible'); });
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3, rootMargin: '0px 0px -10% 0px' });

      nodes.forEach(function (n) { io.observe(n); });
    })();
  </script>
</BaseLayout>
