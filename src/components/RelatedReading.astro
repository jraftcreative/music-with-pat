---
// Related blog links by page type. Used on location + service pages to wire
// the blog into the location portfolio (SEO hub-and-spoke). Excludes any
// preview/unpublished posts.
interface Props { type?: string }
const { type = 'piano' } = Astro.props

const POSTS: Record<string, { href: string; title: string }[]> = {
  piano: [
    { href: '/blog/what-age-start-piano-lessons/', title: 'What Age Should a Child Start Piano Lessons?' },
    { href: '/blog/signs-child-ready-piano-lessons/', title: 'Signs Your Child Is Ready for Piano Lessons' },
    { href: '/blog/private-piano-teacher-vs-music-school-singapore/', title: 'Private Teacher vs Music School: Which Is Right?' },
  ],
  violin: [
    { href: '/blog/what-age-start-violin-lessons/', title: 'What Age Should a Child Start Violin Lessons?' },
    { href: '/blog/violin-vs-piano-which-instrument-for-child/', title: 'Violin or Piano: Which Instrument for Your Child?' },
    { href: '/blog/preparing-child-abrsm-violin-exam/', title: 'Preparing Your Child for the ABRSM Violin Exam' },
  ],
  music: [
    { href: '/blog/violin-vs-piano-which-instrument-for-child/', title: 'Violin or Piano: Which Instrument for Your Child?' },
    { href: '/blog/benefits-of-learning-piano-children/', title: 'The Benefits of Learning Piano for Children' },
    { href: '/blog/private-piano-teacher-vs-music-school-singapore/', title: 'Private Teacher vs Music School: Which Is Right?' },
  ],
  theory: [
    { href: '/blog/why-music-theory-matters-young-pianists/', title: 'Why Music Theory Matters for Young Pianists' },
    { href: '/blog/abrsm-vs-trinity-piano-exam-board-singapore/', title: 'ABRSM vs Trinity: Which Exam Board?' },
    { href: '/blog/how-to-prepare-abrsm-piano-exam-singapore/', title: 'How to Prepare for the ABRSM Piano Exam' },
  ],
  'abrsm-piano': [
    { href: '/blog/how-to-prepare-abrsm-piano-exam-singapore/', title: 'How to Prepare for the ABRSM Piano Exam' },
    { href: '/blog/abrsm-piano-exams-singapore-guide/', title: 'ABRSM Piano Exams in Singapore: A Guide' },
    { href: '/blog/abrsm-vs-trinity-piano-exam-board-singapore/', title: 'ABRSM vs Trinity: Which Exam Board?' },
  ],
  'abrsm-violin': [
    { href: '/blog/preparing-child-abrsm-violin-exam/', title: 'Preparing Your Child for the ABRSM Violin Exam' },
    { href: '/blog/abrsm-vs-trinity-piano-exam-board-singapore/', title: 'ABRSM vs Trinity: Which Exam Board?' },
    { href: '/blog/what-age-start-violin-lessons/', title: 'What Age Should a Child Start Violin Lessons?' },
  ],
}

const posts = POSTS[type] ?? POSTS.piano
---

<section class="py-12 md:py-16 px-6 md:px-12 bg-primary-50">
  <div class="max-w-5xl mx-auto w-full">
    <p class="text-xs md:text-sm font-medium uppercase tracking-[0.18em] text-primary-700 mb-6">Helpful reading</p>
    <div class="grid sm:grid-cols-3 gap-6">
      {posts.map((p) => (
        <a href={p.href} class="block border-t border-primary-200 pt-4 group">
          <h3 class="font-serif font-semibold text-base md:text-lg text-base-900 leading-snug group-hover:text-primary-700 transition-colors">{p.title}</h3>
          <span class="inline-block mt-2 text-sm text-primary-600 font-medium">Read more &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
